@page "/approvals"
@model Seneschal.Api.Pages.ApprovalsModel
@using Seneschal.Core.Enums
@{ Layout = null; }
<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Seneschal Approvals</title><link rel="stylesheet" href="/styles.css" /></head>
<body><div class="app-shell">
@await Html.PartialAsync("Shared/_PortalSidebar", "approvals")
<main class="container explorer-page approvals-page">
<header class="page-header"><div><div class="breadcrumb">Governance / Approvals</div><h1>Approvals</h1>
<p class="subtitle">Resolve capability requests that require a manual human decision.</p></div></header>
<p class="governance-volatile-note"><strong>Temporary runtime state.</strong> Approval records are held in memory and reset when Seneschal restarts.</p>
<section class="panel"><div class="table-scroll"><table><thead><tr><th>Status</th><th>Identity</th><th>Capability</th><th>Environment</th><th>Resource</th><th>Reason</th><th>Requested</th><th>Action</th></tr></thead><tbody>
@if (Model.Approvals.Count == 0) { <tr><td colspan="8" class="muted">No approval requests have been recorded.</td></tr> }
@foreach (var approval in Model.Approvals) {
<tr><td><span class="decision-badge decision-pending">@approval.Status</span></td><td>@approval.IdentityId</td><td>@approval.CapabilityId</td><td>@approval.Environment</td><td>@approval.ResourceId</td><td>@approval.RequestReason</td><td>@approval.RequestedAt.ToString("u")</td><td>
@if (approval.Status == ApprovalStatus.Pending) {
<form method="post" action="/approvals?handler=Resolve" class="approval-actions"><input type="hidden" name="approvalId" value="@approval.Id" /><label><span class="visually-hidden">Resolved by</span><input name="resolvedBy" required placeholder="Operator name" /></label><button name="resolution" value="Approved" type="submit">Approve</button><button class="button-destructive" name="resolution" value="Rejected" type="submit">Reject</button></form>
} else { <span>@approval.ResolvedAt?.ToString("u") by @approval.ResolvedBy</span> }
</td></tr> }
</tbody></table></div></section></main></div></body></html>
