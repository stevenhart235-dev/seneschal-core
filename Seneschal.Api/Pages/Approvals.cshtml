@page "/approvals"
@model Seneschal.Api.Pages.ApprovalsModel
@using Seneschal.Core.Enums
@{ Layout = null; }
<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Seneschal Approvals</title><link rel="stylesheet" href="/styles.css" /></head>
<body><div class="app-shell">
@await Html.PartialAsync("Shared/_PortalSidebar", "approvals")
<main class="container explorer-page approvals-page">
<header class="page-header"><div><div class="breadcrumb">Governance / Approvals</div><h1>Approvals</h1>
<p class="subtitle">Resolve capability requests that require a manual human decision.</p></div></header>
<p class="governance-volatile-note"><strong>Temporary runtime state.</strong> Approval records are held in memory and reset when Seneschal restarts.</p>
<p class="approval-correlation-note"><strong>Approval scope:</strong> Operation ID provides exact operation correlation. Requests without one temporarily use legacy context matching.</p>
<section class="approval-section" aria-labelledby="pendingApprovalsTitle"><header><h2 id="pendingApprovalsTitle">Pending approvals</h2><span>@Model.Approvals.Count(item => item.Status == ApprovalStatus.Pending)</span></header>
<div class="approval-card-grid">
@foreach (var approval in Model.Approvals.Where(item => item.Status == ApprovalStatus.Pending)) {
<article class="panel approval-card"><div class="approval-card-heading"><span class="decision-badge approval-status approval-status-pending">Pending</span><code>@approval.Id</code></div><h3>@approval.CapabilityId</h3><p>@approval.RequestReason</p><dl><div><dt>Identity</dt><dd>@approval.IdentityId</dd></div><div><dt>Environment</dt><dd>@approval.Environment</dd></div><div><dt>Resource</dt><dd>@approval.ResourceId</dd></div><div><dt>Operation ID</dt><dd>@(approval.OperationId ?? "Not provided")</dd></div><div><dt>Correlation</dt><dd>@(approval.CorrelationMode == ApprovalCorrelationMode.Operation ? "Operation" : "Legacy Context")</dd></div><div><dt>Requested</dt><dd>@approval.RequestedAt.ToString("u")</dd></div></dl><form method="post" action="/approvals?handler=Resolve" class="approval-actions"><input type="hidden" name="approvalId" value="@approval.Id" /><label><span class="visually-hidden">Resolved by</span><input name="resolvedBy" required placeholder="Operator name" /></label><button name="resolution" value="Approved" type="submit">Approve</button><button class="button-destructive" name="resolution" value="Rejected" type="submit">Reject</button></form></article>
}
@if (!Model.Approvals.Any(item => item.Status == ApprovalStatus.Pending)) { <p class="panel empty-state">No pending approvals.</p> }
</div></section>
<section class="approval-section" aria-labelledby="approvalHistoryTitle"><header><h2 id="approvalHistoryTitle">Approval history</h2><span>@Model.Approvals.Count(item => item.Status != ApprovalStatus.Pending)</span></header><div class="approval-history-list">
@foreach (var approval in Model.Approvals.Where(item => item.Status != ApprovalStatus.Pending)) {
<article class="panel approval-history-row"><div><span class="decision-badge approval-status approval-status-@approval.Status.ToString().ToLowerInvariant()">@approval.Status</span><strong>@approval.CapabilityId</strong><small>@approval.IdentityId</small></div><dl><div><dt>Operation ID</dt><dd>@(approval.OperationId ?? "Not provided")</dd></div><div><dt>Correlation</dt><dd>@(approval.CorrelationMode == ApprovalCorrelationMode.Operation ? "Operation" : "Legacy Context")</dd></div><div><dt>Resource</dt><dd>@approval.ResourceId</dd></div><div><dt>Requested</dt><dd>@approval.RequestedAt.ToString("u")</dd></div><div><dt>Resolved</dt><dd>@(approval.ResolvedAt?.ToString("u") ?? "—")</dd></div><div><dt>Resolved by</dt><dd>@(approval.ResolvedBy ?? "—")</dd></div><div><dt>Consumed</dt><dd>@(approval.ConsumedAt?.ToString("u") ?? "—")</dd></div></dl></article>
}
@if (!Model.Approvals.Any(item => item.Status != ApprovalStatus.Pending)) { <p class="panel empty-state">No approval history.</p> }
</div></section></main></div></body></html>
