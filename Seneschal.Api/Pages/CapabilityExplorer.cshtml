@page "/capability-explorer"
@model Seneschal.Api.Pages.CapabilityExplorerModel
@{
    Layout = null;
    var capability = Model.Overview?.CatalogEntry.Capability;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Seneschal Capability Explorer</title>
    <link rel="stylesheet" href="/styles.css" />
</head>
<body>
    <div class="app-shell">
        @await Html.PartialAsync("Shared/_PortalSidebar", "capabilities")

    <main class="container explorer-page">
        <header class="page-header">
            <div class="breadcrumb">Governance / Capabilities</div>
            <h1>Seneschal Capability Explorer</h1>
            <p class="subtitle">
                Search for a capability to inspect its catalog metadata,
                governance summary, and projected relationships.
            </p>
            <p>
                <a class="button-link" href="/graph-view">
                    Open Interactive Graph
                </a>
            </p>
        </header>

        <form class="search-panel" method="get">
            <label for="q">Search capabilities</label>
            <div class="search-row">
                <input
                    id="q"
                    name="q"
                    value="@Model.Query"
                    placeholder="Search by id, name, description, or tag" />
                <button type="submit">Search</button>
            </div>
        </form>

        @if (Model.SearchWasRequested)
        {
            <section class="panel">
                <h2>Search Results</h2>

                @if (Model.SearchResults.Count == 0)
                {
                    <div class="empty-state">
                        <p class="muted">
                            No capabilities matched
                            <span class="code">@Model.Query</span>.
                        </p>
                        <p class="muted">
                            The Capability Explorer searches the configured
                            capability catalog. Try a provider, tag, or full
                            capability id such as
                            <span class="code">azure.keyvault.secret.read</span>.
                        </p>
                    </div>
                }
                else
                {
                    <ul class="search-results">
                        @foreach (var result in Model.SearchResults)
                        {
                            var resultCapability = result.Capability;
                            <li>
                                <a href="/capability-explorer?q=@Uri.EscapeDataString(Model.Query ?? string.Empty)&capabilityId=@Uri.EscapeDataString(resultCapability.Id)">
                                    @resultCapability.Id
                                </a>
                                <span>@resultCapability.Description</span>
                            </li>
                        }
                    </ul>
                }
            </section>
        }

        @if (Model.CapabilityWasRequested && Model.Overview is null)
        {
            <section class="notice">
                <h2>Capability not found</h2>
                <p class="muted">
                    No capability was found for
                    <span class="code">@Model.CapabilityId</span>.
                    Capability pages are created from catalog entries, so this
                    may be empty until the capability is configured.
                </p>
                <p class="muted">
                    Try searching the catalog, or use a known id such as
                    <span class="code">azure.keyvault.secret.read</span>.
                </p>
            </section>
        }
        else if (Model.Overview is not null && capability is not null)
        {
            <section class="panel capability-profile-header">
                <div class="capability-title-row">
                    <div>
                        <p class="muted capability-eyebrow">Capability Profile</p>
                        <h2>@capability.Name</h2>
                        <p class="code capability-id">@capability.Id</p>
                    </div>
                    <div class="badge-row">
                        <span class="badge risk-badge risk-@capability.RiskLevel.ToString().ToLowerInvariant()">
                            @capability.RiskLevel risk
                        </span>
                        <span class="badge badge-category">@capability.Category</span>
                        <span class="badge badge-provider">@capability.Provider</span>
                    </div>
                </div>

                <p class="capability-description">
                    @capability.Description
                </p>

                @if (!string.IsNullOrWhiteSpace(capability.Owner) ||
                    !string.IsNullOrWhiteSpace(capability.Version) ||
                    capability.Tags.Count > 0)
                {
                    <dl class="metadata-grid compact-metadata-grid">
                        @if (!string.IsNullOrWhiteSpace(capability.Owner))
                        {
                            <dt>Owner</dt>
                            <dd>@capability.Owner</dd>
                        }

                        @if (!string.IsNullOrWhiteSpace(capability.Version))
                        {
                            <dt>Version</dt>
                            <dd>@capability.Version</dd>
                        }

                        @if (capability.Tags.Count > 0)
                        {
                            <dt>Tags</dt>
                            <dd>@string.Join(", ", capability.Tags)</dd>
                        }
                    </dl>
                }
            </section>

            <section class="panel capability-runtime-panel">
                <div class="dashboard-section-header">
                    <div>
                        <h2>Runtime Summary</h2>
                        <p class="muted">
                            Observed decisions for this capability from the
                            in-memory activity store.
                        </p>
                    </div>
                    <a class="button-link" href="/audit?capabilityId=@Uri.EscapeDataString(capability.Id)">
                        View Audit Trail
                    </a>
                </div>

                @if (!Model.HasRuntimeActivity)
                {
                    <div class="empty-state runtime-empty-state">
                        <p class="muted">
                            No runtime activity has been observed for this
                            capability yet.
                        </p>
                        <p class="muted">
                            Runtime summary appears after applications or users
                            evaluate this capability through Seneschal.
                        </p>
                    </div>
                }
                else
                {
                    var runtime = Model.RuntimeActivity!;
                    <section class="dashboard-grid capability-runtime-grid">
                        <article class="dashboard-card activity-card">
                            <strong>@runtime.TotalRequests</strong>
                            <span>Total requests</span>
                        </article>
                        <article class="dashboard-card activity-card">
                            <strong>@runtime.AllowedCount</strong>
                            <span>Allowed</span>
                        </article>
                        <article class="dashboard-card activity-card">
                            <strong>@runtime.DeniedCount</strong>
                            <span>Denied</span>
                        </article>
                        <article class="dashboard-card activity-card">
                            <strong>@runtime.PendingApprovalCount</strong>
                            <span>Pending approval</span>
                        </article>
                        <article class="dashboard-card activity-card">
                            <strong>@(runtime.LastUsedUtc?.ToString("u") ?? "n/a")</strong>
                            <span>Last used</span>
                        </article>
                        <article class="dashboard-card activity-card">
                            <strong>@runtime.AverageEvaluationDurationMs.ToString("0.##")</strong>
                            <span>Avg duration ms</span>
                        </article>
                    </section>
                }
            </section>

            <section class="panel">
                <h2>Governance Relationships</h2>
                <h3 class="monitor-subheading">Governance Summary</h3>
                <div class="summary-grid capability-summary-grid">
                    <div class="summary-card">
                        <strong>@Model.Overview.Summary.AssignedIdentityCount</strong>
                        <span>Assigned Identities</span>
                    </div>
                    <div class="summary-card">
                        <strong>@Model.Overview.Summary.ObservedIdentityCount</strong>
                        <span>Observed Identities</span>
                    </div>
                    <div class="summary-card">
                        <strong>@Model.Overview.Summary.ResourceCount</strong>
                        <span>Resources</span>
                    </div>
                    <div class="summary-card">
                        <strong>@Model.Overview.Summary.GoverningPolicyCount</strong>
                        <span>Governing Policies</span>
                    </div>
                </div>
                <p class="muted relationship-origin-summary">
                    Origins:
                    @string.Join(", ", Model.Overview.Summary.Origins)
                </p>

                @{
                    var groups = Model.GetRelationshipGroups();
                }

                @if (groups.Count == 0)
                {
                    <div class="empty-state">
                        <p class="muted">
                            No relationships found for this capability yet.
                        </p>
                        <p class="muted">
                            Relationships are projected from sources such as
                            policies and observations. They appear when a policy
                            targets this capability or when usage is observed.
                        </p>
                    </div>
                }
                else
                {
                    <div class="relationship-compact-grid">
                        @foreach (var group in groups)
                        {
                            <section class="relationship-group relationship-compact-group">
                                <h3>@group.Label</h3>
                                <ul class="relationship-compact-list">
                                    @foreach (var item in group.Items)
                                    {
                                        <li>
                                            <span class="relationship-chip">@item.Label</span>
                                            <small>@item.Origin · @item.SourceSystem</small>
                                        </li>
                                    }
                                </ul>
                            </section>
                        }
                    </div>
                }
            </section>

            <section class="dashboard-columns capability-profile-columns">
                <article class="panel compact-panel">
                    <h2>Recent Decisions</h2>
                    <p>
                        <a class="table-link" href="/audit?capabilityId=@Uri.EscapeDataString(capability.Id)">
                            View filtered audit trail
                        </a>
                    </p>

                    @if (Model.RecentDecisions.Count == 0)
                    {
                        <div class="empty-state">
                            <p class="muted">
                                No recent audit events were found for this
                                capability.
                            </p>
                        </div>
                    }
                    else
                    {
                        <ul class="compact-list activity-list">
                            @foreach (var decision in Model.RecentDecisions)
                            {
                                <li>
                                    <span>
                                        @decision.TimestampUtc.ToString("u") ·
                                        @decision.IdentityId
                                    </span>
                                    <span>
                                        @decision.Decision · @decision.Reason
                                    </span>
                                </li>
                            }
                        </ul>
                    }
                </article>

                <article class="panel compact-panel">
                    <h2>Recommendations</h2>
                    <p class="monitor-recommendation">
                        @Model.GetRecommendation()
                    </p>
                    <p class="muted">
                        Use the Monitor Dashboard to review readiness, drift,
                        and enforcement recommendations before changing runtime
                        posture.
                    </p>
                    <a class="button-link" href="/monitor">
                        Open Monitor Dashboard
                    </a>
                </article>
            </section>

            <section class="panel">
                <h2>Graph View</h2>
                @{
                    var graphGroups = Model.GetGraphNodeGroups();
                }

                @if (graphGroups.Count == 0)
                {
                    <div class="empty-state">
                        <p class="muted">
                            No connected graph nodes are available for this
                            capability yet.
                        </p>
                        <p class="muted">
                            The graph is drawn from relationship data. It will
                            populate after policies, identities, resources, or
                            observed usage connect to this capability.
                        </p>
                    </div>
                }
                else
                {
                    <div class="ego-graph" aria-label="Capability ego graph">
                        <div class="graph-center">
                            <span class="graph-node graph-node-capability">
                                @capability.Id
                            </span>
                        </div>

                        <div class="graph-spokes">
                            @foreach (var graphGroup in graphGroups)
                            {
                                <section class="graph-node-group">
                                    <h3>@graphGroup.Label</h3>
                                    <ul>
                                        @foreach (var node in graphGroup.Nodes)
                                        {
                                            <li>
                                                <span class="graph-connector" aria-hidden="true"></span>
                                                <span class="graph-node graph-node-@node.Type.ToLowerInvariant()">
                                                    @node.Label
                                                </span>
                                            </li>
                                        }
                                    </ul>
                                </section>
                            }
                        </div>
                    </div>
                }
            </section>
        }

        <footer class="app-footer">Seneschal v0.2.1-alpha</footer>
    </main>
    </div>
</body>
</html>
