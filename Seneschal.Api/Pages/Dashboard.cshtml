@page "/dashboard"
@model Seneschal.Api.Pages.DashboardModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = null;
    var total = Math.Max(1, Model.TotalRuntimeDecisions);
    var allowPercent = Model.AllowedRuntimeDecisions * 100d / total;
    var denyPercent = Model.DeniedRuntimeDecisions * 100d / total;
    var pendingPercent = Model.PendingApprovalRuntimeDecisions * 100d / total;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Seneschal Dashboard</title>
    <link rel="stylesheet" href="/styles.css" asp-append-version="true" />
</head>
<body>
<div class="app-shell">
    @await Html.PartialAsync("Shared/_PortalSidebar", "dashboard")
    <main class="container demo-dashboard">
        <header class="demo-dashboard-header">
            <div>
                <nav class="breadcrumb" aria-label="Breadcrumb">Overview</nav>
                <h1>Dashboard</h1>
            </div>
            <div class="dashboard-status-group" aria-label="Dashboard live status">
                <span class="live-indicator" id="dashboard-live-state"><span aria-hidden="true"></span><strong id="dashboard-live-status-label">Connecting</strong></span>
                <span class="demo-runtime-mode" id="governance-posture-mode">@Model.Live.CurrentMode</span>
                <span id="dashboard-refresh-status" class="visually-hidden">Polling active</span>
                <span>Updated <time id="dashboard-last-updated" datetime="@Model.Live.GeneratedAtUtc.ToString("O")" data-relative-time="@Model.Live.GeneratedAtUtc.ToString("O")">just now</time></span>
                <button type="button" class="demo-dashboard-refresh" id="dashboard-refresh" aria-label="Refresh Dashboard status">Refresh</button>
            </div>
        </header>

        <section class="dashboard-technology-posture" aria-labelledby="technology-posture-title">
            <header class="dashboard-section-header">
                <div>
                    <span>Investigation starting points</span>
                    <h2 id="technology-posture-title">Technology Posture</h2>
                </div>
                <a href="/technologies">Explore all technologies</a>
            </header>
            <div class="dashboard-technology-grid">
                @foreach (var technology in Model.Technologies)
                {
                    var requiresAttention = technology.DenyCount + technology.PendingApprovalCount > 0;
                    var state = technology.EvaluationCount == 0
                        ? "Configured · not observed"
                        : requiresAttention
                            ? "Attention required"
                            : "Healthy";
                    var stateClass = requiresAttention
                        ? "dashboard-technology-card--attention"
                        : technology.EvaluationCount > 0
                            ? "dashboard-technology-card--healthy"
                            : "dashboard-technology-card--unobserved";
                    <a class="dashboard-technology-card @stateClass"
                       href="/technologies/@Uri.EscapeDataString(technology.Key)"
                       aria-label="Investigate @technology.DisplayName technology">
                        <div class="dashboard-technology-card__header">
                            <span class="dashboard-technology-card__icon">
                                <img src="@technology.IconPath" alt="" width="32" height="32" />
                            </span>
                            <span class="dashboard-technology-card__identity">
                                <strong>@technology.DisplayName</strong>
                                <span>@state</span>
                            </span>
                        </div>
                        <dl class="dashboard-technology-card__metrics">
                            <div><dt>Denied</dt><dd class="metric-deny">@technology.DenyCount</dd></div>
                            <div><dt>Pending</dt><dd class="metric-pending">@technology.PendingApprovalCount</dd></div>
                            <div><dt>Evaluations</dt><dd>@technology.EvaluationCount</dd></div>
                        </dl>
                    </a>
                }
            </div>
        </section>

        <section class="demo-metric-strip" aria-label="Current runtime metrics">
            <article><span>Active capabilities</span><strong id="live-capability-count">@Model.Live.ActiveCapabilityCount</strong></article>
            <article><span>Denied decisions</span><strong class="metric-deny" id="attention-deny-count">@Model.DeniedRuntimeDecisions</strong></article>
            <article><span>Pending approvals</span><strong class="metric-pending" id="attention-pending-count">@Model.PendingApprovalRuntimeDecisions</strong></article>
            <article><span>Active windows</span><strong>@(Model.GovernanceWindow.Enabled ? 1 : 0)</strong></article>
            <article><span>Recent evaluations</span><strong id="live-total-decisions">@Model.Live.TotalDecisions</strong></article>
        </section>

        <section class="demo-supporting-grid" aria-label="Supporting runtime information">
            <article class="demo-console-panel demo-runtime-summary">
                <header class="demo-panel-header"><h2>Runtime Summary</h2><a href="/governance">Runtime Governance</a></header>
                <dl>
                    <div><dt>Mode</dt><dd id="runtime-summary-mode">@Model.Live.CurrentMode</dd></div>
                    <div><dt>Audit evidence</dt><dd>@(Model.AuditEventsAvailable ? "Available" : "Not observed")</dd></div>
                    <div><dt>Average latency</dt><dd>@Model.AverageEvaluationDurationMs.ToString("0.##") ms</dd></div>
                    <div><dt>Last evaluation</dt><dd><time id="live-last-evaluation" datetime="@Model.Live.LastEvaluationUtc?.ToString("O")">@(Model.Live.LastEvaluationUtc?.ToString("u") ?? "None")</time></dd></div>
                </dl>
            </article>

            <article class="demo-console-panel demo-top-capabilities">
                <header class="demo-panel-header"><h2>Top Capabilities</h2><a href="/capability-explorer">Capability Explorer</a></header>
                <ol id="top-capability-list">
                @foreach (var capability in Model.TopCapabilitiesByRequestCount.Take(4))
                {
                    var width = Model.MostActiveCapability?.TotalRequests > 0
                        ? capability.TotalRequests * 100d / Model.MostActiveCapability.TotalRequests
                        : 0;
                    <li><a href="/capability-activity?capabilityId=@Uri.EscapeDataString(capability.CapabilityId)">@capability.CapabilityId</a><span><i style="width: @width.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%"></i></span><strong>@capability.TotalRequests</strong></li>
                }
                </ol>
            </article>

            <article class="demo-console-panel demo-decision-distribution">
                <header class="demo-panel-header"><h2>Decision Distribution</h2><a href="/audit">Audit Trail</a></header>
                <div class="demo-distribution-body">
                    <div class="reference-donut @(Model.TotalRuntimeDecisions == 0 ? "is-empty" : "")" id="decision-distribution" style="--allow: @allowPercent; --deny: @denyPercent; --pending: @pendingPercent" role="img" aria-label="Allow @Model.AllowedRuntimeDecisions, Deny @Model.DeniedRuntimeDecisions, Pending Approval @Model.PendingApprovalRuntimeDecisions"><div><strong id="distribution-total-count">@Model.TotalRuntimeDecisions</strong><span>Total</span></div></div>
                    <dl><div class="distribution-allow"><dt>Allow</dt><dd id="distribution-allow-count">@Model.AllowedRuntimeDecisions</dd></div><div class="distribution-deny"><dt>Deny</dt><dd id="distribution-deny-count">@Model.DeniedRuntimeDecisions</dd></div><div class="distribution-pending"><dt>Pending</dt><dd id="distribution-pending-count">@Model.PendingApprovalRuntimeDecisions</dd></div></dl>
                </div>
            </article>
        </section>
    </main>
</div>
<script src="/dashboard-live.js" defer></script>
</body>
</html>
