@page "/dashboard"
@model Seneschal.Api.Pages.DashboardModel
@{
    Layout = null;
    var decisionTotal = Math.Max(1, Model.TotalRuntimeDecisions);
    var allowPercent = Model.AllowedRuntimeDecisions * 100d / decisionTotal;
    var denyPercent = Model.DeniedRuntimeDecisions * 100d / decisionTotal;
    var pendingPercent = Model.PendingApprovalRuntimeDecisions * 100d / decisionTotal;
    var projectedAffected = Model.DeniedRuntimeDecisions + Model.PendingApprovalRuntimeDecisions;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Seneschal Dashboard</title>
    <link rel="stylesheet" href="/styles.css" />
</head>
<body>
    <div class="app-shell">
        @await Html.PartialAsync("Shared/_PortalSidebar", "dashboard")

        <main class="container reference-dashboard">
            <header class="reference-dashboard-header">
                <div>
                    <div class="breadcrumb">Overview</div>
                    <h1>Dashboard</h1>
                    <p>Runtime governance across integrated applications.</p>
                </div>
                <div class="reference-live-state">
                    <span class="live-indicator" id="dashboard-live-state"><span aria-hidden="true"></span>Live</span>
                    <span id="dashboard-refresh-status" class="visually-hidden">Polling active</span>
                    <a href="/governance">Runtime Governance</a>
                </div>
            </header>

            <section class="dashboard-window-strip @(Model.GovernanceWindow.Enabled ? "is-active" : "")" aria-label="Active Governance Windows">
                <div>
                    <span>Active Governance Windows</span>
                    <strong>@(Model.GovernanceWindow.Enabled ? "1" : "0")</strong>
                </div>
                <p>@(Model.GovernanceWindow.Enabled ? $"{Model.GovernanceWindow.Name} · {Model.GovernanceWindow.Mode}" : "No governance windows are active.")</p>
                <a href="/governance-windows">Review governance windows</a>
            </section>

            <section class="reference-kpi-grid" aria-label="Runtime summary">
                <article class="reference-kpi mode-kpi" id="governance-posture">
                    <span class="reference-kpi-symbol" aria-hidden="true">◆</span>
                    <div><span>Runtime posture</span><strong id="governance-posture-title">@(Model.Live.CurrentMode == "LogOnly" ? "Monitoring" : "Enforcing")</strong><small>Canonical mode: <b id="governance-posture-mode">@Model.Live.CurrentMode</b></small></div>
                    <p id="governance-posture-description">@(Model.Live.CurrentMode == "LogOnly" ? "Decisions recorded; operations continue" : "Deny and pending projected blocked")</p>
                </article>
                <article class="reference-kpi">
                    <span class="reference-kpi-symbol live-symbol" aria-hidden="true">●</span>
                    <div><span>Active identities</span><strong id="live-identity-count">@Model.Live.ActiveIdentityCount</strong><small>Evaluated in the last 20 seconds</small></div>
                </article>
                <article class="reference-kpi">
                    <span class="reference-kpi-symbol live-symbol" aria-hidden="true">◇</span>
                    <div><span>Active capabilities</span><strong id="live-capability-count">@Model.Live.ActiveCapabilityCount</strong><small>Current runtime activity</small></div>
                </article>
                <article class="reference-kpi deny-kpi">
                    <span class="reference-kpi-symbol" aria-hidden="true">!</span>
                    <div><span>Denied decisions</span><strong id="attention-deny-count">@Model.DeniedRuntimeDecisions</strong><small>Available runtime evidence</small></div>
                </article>
                <article class="reference-kpi pending-kpi">
                    <span class="reference-kpi-symbol" aria-hidden="true">◷</span>
                    <div><span>Pending Approval</span><strong id="attention-pending-count">@Model.PendingApprovalRuntimeDecisions</strong><small>Awaiting governance outcome</small></div>
                </article>
            </section>

            <section class="reference-primary-grid">
                <article class="reference-card reference-activity-card" aria-labelledby="live-activity-title">
                    <header class="reference-card-header">
                        <div><h2 id="live-activity-title">Live Decision Activity</h2><p>Identity, capability, decision, and projected action</p></div>
                        <span class="live-update-label" aria-live="polite" id="live-update-label">Watching for evaluations</span>
                    </header>
                    <ol class="reference-activity-feed" id="live-decision-feed">
                        @foreach (var decision in Model.Live.Decisions.Take(6))
                        {
                            <li data-event-id="@decision.Id">
                                <details class="reference-event-disclosure">
                                    <summary>
                                        <a class="reference-event-identity" href="/identity-activity?identityId=@Uri.EscapeDataString(decision.Identity)">@decision.Identity</a>
                                        <a class="reference-event-capability" href="/capability-activity?capabilityId=@Uri.EscapeDataString(decision.Capability)">@decision.Capability</a>
                                        <span class="decision-badge decision-@decision.Decision.ToLowerInvariant()">@(decision.Decision == "PendingApproval" ? "Pending Approval" : decision.Decision)</span>
                                        <strong class="effective-action effective-@decision.EffectiveAction.Replace(" ", "-").ToLowerInvariant()">→ @decision.EffectiveAction</strong>
                                        <time datetime="@decision.TimestampUtc.ToString("O")" data-relative-time="@decision.TimestampUtc.ToString("O")">@decision.TimestampUtc.ToString("u")</time>
                                        <span class="reference-event-chevron" aria-hidden="true"></span>
                                    </summary>
                                    <dl class="reference-event-details">
                                        <div><dt>Reason</dt><dd>@decision.Reason</dd></div>
                                        <div><dt>Matched policy</dt><dd>@(string.IsNullOrWhiteSpace(decision.MatchedPolicy) ? "None" : decision.MatchedPolicy)</dd></div>
                                        <div><dt>Runtime mode</dt><dd>@decision.Mode</dd></div>
                                        <div><dt>Identity</dt><dd>@decision.Identity</dd></div>
                                        <div><dt>Capability</dt><dd>@decision.Capability</dd></div>
                                    </dl>
                                </details>
                            </li>
                        }
                    </ol>
                    @if (Model.Live.Decisions.Count == 0)
                    {
                        <p class="empty-state" id="live-decision-empty">No evaluations have been recorded in this runtime.</p>
                    }
                    <footer><a href="/audit">View full audit trail →</a></footer>
                </article>

                <article class="reference-card reference-distribution-card" aria-labelledby="distribution-title">
                    <header class="reference-card-header"><div><h2 id="distribution-title">Decision Distribution</h2><p>Current runtime</p></div></header>
                    <div class="reference-donut @(Model.TotalRuntimeDecisions == 0 ? "is-empty" : "")" id="decision-distribution" style="--allow: @allowPercent; --deny: @denyPercent; --pending: @pendingPercent" role="img" aria-label="Allow @Model.AllowedRuntimeDecisions, Deny @Model.DeniedRuntimeDecisions, Pending Approval @Model.PendingApprovalRuntimeDecisions">
                        <div><strong id="live-total-decisions">@Model.TotalRuntimeDecisions</strong><span>Total decisions</span></div>
                    </div>
                    <dl class="reference-distribution-legend">
                        <div class="distribution-allow"><dt>Allow</dt><dd id="distribution-allow-count">@Model.AllowedRuntimeDecisions</dd></div>
                        <div class="distribution-deny"><dt>Deny</dt><dd id="distribution-deny-count">@Model.DeniedRuntimeDecisions</dd></div>
                        <div class="distribution-pending"><dt>Pending Approval</dt><dd id="distribution-pending-count">@Model.PendingApprovalRuntimeDecisions</dd></div>
                    </dl>
                    <footer><a href="/capability-activity">View capability activity →</a></footer>
                </article>

                <aside class="reference-card reference-attention-card" aria-labelledby="attention-title">
                    <header class="reference-card-header"><div><h2 id="attention-title">Needs Attention</h2><p>Current governance exceptions</p></div></header>
                    <div class="reference-attention-item deny-attention">
                        <span>Deny</span><strong><b id="attention-deny-detail-count">@Model.DeniedRuntimeDecisions</b> decisions</strong>
                        <p>@(Model.MostDeniedCapability?.CapabilityId ?? "No denied capability observed")</p>
                        <a href="/audit?decision=deny">Investigate denials</a>
                    </div>
                    <div class="reference-attention-item pending-attention">
                        <span>Pending Approval</span><strong><b id="attention-pending-detail-count">@Model.PendingApprovalRuntimeDecisions</b> decisions</strong>
                        <p>@(Model.Activity.Capabilities.Where(capability => capability.PendingApprovalCount > 0).OrderByDescending(capability => capability.LastUsedUtc).FirstOrDefault()?.CapabilityId ?? "No pending capability observed")</p>
                        <a href="/audit?decision=requires_approval">Review pending activity</a>
                    </div>
                    <div class="reference-attention-item">
                        <span>Incidents</span><strong>Operational queue</strong><p>Review aggregated governance incidents.</p><a href="/incidents">Open incidents</a>
                    </div>
                </aside>
            </section>

            <section class="reference-secondary-grid">
                <article class="reference-card projected-impact-card">
                    <header class="reference-card-header"><div><h2>Projected Application Impact</h2><p>Mode-derived behavior; external execution is not confirmed</p></div></header>
                    <div class="reference-impact-value"><strong id="application-impact-value">@(Model.Live.CurrentMode == "Enforce" ? projectedAffected : 0)</strong><span>projected blocked</span></div>
                    <p id="application-impact-description">@(Model.Live.CurrentMode == "LogOnly" ? $"{projectedAffected} denied or pending operations would continue and be recorded." : "Denied and pending operations are projected as blocked while Enforce is active.")</p>
                    <dl class="reference-impact-breakdown @(Model.Live.CurrentMode == "Enforce" ? "" : "is-hidden")" id="application-impact-breakdown">
                        <div><dt>Denied</dt><dd id="application-impact-denied">@Model.DeniedRuntimeDecisions</dd></div>
                        <div><dt>Pending approval</dt><dd id="application-impact-pending">@Model.PendingApprovalRuntimeDecisions</dd></div>
                    </dl>
                    <footer><a href="/governance">Review runtime governance →</a></footer>
                </article>

                <article class="reference-card runtime-health-card">
                    <header class="reference-card-header"><div><h2>Runtime Health</h2></div></header>
                    <div class="reference-health-state"><span aria-hidden="true"></span><strong>Healthy</strong><small>Seneschal is responding</small></div>
                    <dl><div><dt>Runtime mode</dt><dd>@Model.Live.CurrentMode</dd></div><div><dt>Audit evidence</dt><dd>@(Model.AuditEventsAvailable ? "Available" : "Not observed")</dd></div><div><dt>Evaluations</dt><dd>@Model.TotalRuntimeDecisions</dd></div></dl>
                    <footer><a href="/diagnostics-view">View diagnostics →</a></footer>
                </article>

                <article class="reference-card reference-capabilities-card">
                    <header class="reference-card-header"><div><h2>Most Active Capabilities</h2><p>Evaluation volume in this runtime</p></div></header>
                    <ol>
                        @foreach (var capability in Model.TopCapabilitiesByRequestCount)
                        {
                            var relativeWidth = Model.MostActiveCapability?.TotalRequests > 0
                                ? capability.TotalRequests * 100d / Model.MostActiveCapability.TotalRequests
                                : 0;
                            <li><a href="/capability-activity?capabilityId=@Uri.EscapeDataString(capability.CapabilityId)">@capability.CapabilityId</a><div><span style="width: @relativeWidth.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%"></span></div><strong>@capability.TotalRequests</strong></li>
                        }
                    </ol>
                    <footer><a href="/capability-activity">View all capabilities →</a></footer>
                </article>
            </section>

            <section class="reference-coverage-strip" aria-label="Governance coverage">
                <span>Governance coverage</span>
                <a href="/capability-explorer"><strong>@Model.TotalCapabilities</strong> capabilities</a>
                <a href="/identity-explorer"><strong>@Model.TotalIdentities</strong> identities</a>
                <a href="/policies"><strong>@Model.TotalPolicies</strong> policies</a>
                <a href="/audit"><strong>@Model.TotalRuntimeDecisions</strong> evaluations</a>
            </section>
        </main>
    </div>
    <script src="/dashboard-live.js" defer></script>
</body>
</html>
