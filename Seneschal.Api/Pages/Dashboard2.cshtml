@page "/dashboard2"
@model Seneschal.Api.Pages.DashboardLabModel
@using Seneschal.Api.Pages
@using Seneschal.Core.Enums
@{
    Layout = "Shared/_DashboardLabLayout";
    ViewData["Title"] = "Investigation";
    ViewData["LabActive"] = "investigation";
}
<main class="page-body"><div class="container-xl">
<header class="lab-page-header d-flex flex-wrap align-items-end justify-content-between gap-3"><div><div class="page-pretitle">Dashboard Design Lab · Static snapshot</div><h2 class="page-title">Investigation workspace</h2></div><div class="lab-status-row"><span class="badge bg-azure-lt">@Model.Mode</span><a class="btn btn-sm" href="/incidents">Open incidents</a><a class="btn btn-sm" href="/audit">Audit Trail</a></div></header>
<section class="card mb-3"><div class="card-body py-3"><div class="row align-items-center g-3"><div class="col-md"><span class="text-secondary">Requires review</span><div class="h2 mb-0">@(Model.InvestigationQueue.Count + (Model.Window.Enabled ? 1 : 0))</div></div><div class="col-md"><span class="text-secondary">Denied</span><strong class="d-block text-red">@Model.Denied</strong></div><div class="col-md"><span class="text-secondary">Pending Approval</span><strong class="d-block text-yellow">@Model.Pending</strong></div><div class="col-md-5"><span class="text-secondary">Governance posture</span><strong class="d-block">@(Model.Window.Enabled ? $"{Model.Window.Name} · {Model.Window.Mode}" : "No active Governance Window")</strong></div></div></div></section>
<div class="lab-investigation-grid">
<section class="card" aria-labelledby="investigation-work"><div class="card-header"><h3 class="card-title" id="investigation-work">Decisions requiring investigation</h3><span class="badge bg-red-lt ms-auto">@Model.InvestigationQueue.Count evidence items</span></div>
@if(Model.InvestigationQueue.Count == 0){<div class="lab-empty"><strong>No denied or pending decisions</strong><span>There is no decision evidence requiring investigation in the current snapshot.</span></div>}else{<div class="list-group list-group-flush">
@foreach(var item in Model.InvestigationQueue){<article class="list-group-item py-3"><div class="d-flex flex-wrap justify-content-between gap-2 mb-2"><div><span class="badge @DashboardLabModel.BadgeClass(item.Decision)">@DashboardLabModel.DecisionLabel(item.Decision)</span><strong class="ms-2">@item.CapabilityId</strong></div><small class="text-secondary">@DashboardLabModel.Age(item.TimestampUtc)</small></div><div class="row g-2 mb-2 text-secondary"><div class="col-md-4">Identity <a href="/identity-activity?identityId=@Uri.EscapeDataString(item.IdentityId)">@item.IdentityId</a></div><div class="col-md-3">Environment <strong>@(string.IsNullOrWhiteSpace(item.Environment) ? "Not provided" : item.Environment)</strong></div><div class="col-md-5">Policy <strong>@(item.MatchedPolicies.FirstOrDefault() ?? "No matched policy recorded")</strong></div></div><p class="mb-2 lab-reason">@item.Reason</p><div class="btn-list"><a class="btn btn-primary btn-sm" href="/audit/@Uri.EscapeDataString(item.Id)">View Decision Trace</a><a class="btn btn-sm" href="/capability-activity?capabilityId=@Uri.EscapeDataString(item.CapabilityId)">Capability Activity</a>@if(item.Decision == DecisionType.RequireApproval){<a class="btn btn-sm" href="/approvals">Related approval</a>}</div></article>}
</div>}</section>
<aside class="d-flex flex-column gap-3"><section class="card"><div class="card-header"><h3 class="card-title">Investigation paths</h3></div><div class="list-group list-group-flush"><a class="list-group-item list-group-item-action" href="/incidents"><strong>Incidents</strong><small class="d-block text-secondary">Review recorded operational incidents</small></a><a class="list-group-item list-group-item-action" href="/approvals"><strong>Approvals</strong><small class="d-block text-secondary">Resolve pending human decisions</small></a><a class="list-group-item list-group-item-action" href="/audit"><strong>Audit Trail</strong><small class="d-block text-secondary">Filter complete decision evidence</small></a></div></section>
<section class="card"><div class="card-header"><h3 class="card-title">Recent activity</h3></div>@if(Model.Decisions.Count==0){<div class="lab-empty"><strong>No activity recorded</strong><span>There is no secondary evidence to show.</span></div>}else{<div class="list-group list-group-flush">@foreach(var item in Model.Decisions.Take(5)){<a class="list-group-item list-group-item-action" href="/audit/@Uri.EscapeDataString(item.Id)"><div class="d-flex justify-content-between"><strong class="text-truncate">@item.CapabilityId</strong><small>@DashboardLabModel.Age(item.TimestampUtc)</small></div><small class="text-secondary">@item.IdentityId · @DashboardLabModel.DecisionLabel(item.Decision)</small></a>}</div>}</section></aside>
</div></div></main>
