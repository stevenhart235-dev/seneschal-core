@page "/dashboard3"
@model Seneschal.Api.Pages.DashboardLabModel
@using Seneschal.Api.Pages
@{
    Layout = "Shared/_DashboardLabLayout";
    ViewData["Title"] = "Capability";
    ViewData["LabActive"] = "capability";
    var runtime = Model.Activity.Capabilities.ToDictionary(item => item.CapabilityId);
    var maxRequests = Math.Max(1, Model.MostActiveCapabilities.FirstOrDefault()?.TotalRequests ?? 0);
}
<main class="page-body"><div class="container-xl">
<header class="lab-page-header d-flex flex-wrap align-items-end justify-content-between gap-3"><div><div class="page-pretitle">Dashboard Design Lab · Static snapshot</div><h2 class="page-title">Capability posture</h2></div><div class="lab-status-row"><span class="badge bg-azure-lt">@Model.Mode</span><a class="btn btn-primary btn-sm" href="/capability-explorer">Open Capability Explorer</a></div></header>
<section class="row row-cards lab-metrics mb-3" aria-label="Capability posture summary"><div class="col-6 col-md"><article class="card"><div class="card-body"><span class="text-secondary">Inventory</span><div class="h2">@Model.Capabilities.Count</div></div></article></div><div class="col-6 col-md"><article class="card"><div class="card-body"><span class="text-secondary">Observed</span><div class="h2">@Model.Activity.Capabilities.Count</div></div></article></div><div class="col-6 col-md"><article class="card"><div class="card-body"><span class="text-secondary">Identities</span><div class="h2">@Model.Activity.Identities.Count</div></div></article></div><div class="col-6 col-md"><article class="card"><div class="card-body"><span class="text-secondary">Governed evaluations</span><div class="h2">@Model.Activity.Capabilities.Sum(item => item.GovernedEvaluationCount)</div></div></article></div></section>
<div class="lab-capability-grid">
<section class="card" aria-labelledby="capability-inventory"><div class="card-header"><h3 class="card-title" id="capability-inventory">Capability inventory</h3><span class="text-secondary ms-auto">Existing catalog and runtime evidence</span></div>
@if(Model.Capabilities.Count==0){<div class="lab-empty"><strong>No capabilities configured</strong><span>Add catalog entries before reviewing capability posture.</span></div>}else{<div class="list-group list-group-flush">@foreach(var entry in Model.Capabilities.OrderByDescending(x => x.Capability.RiskLevel).ThenBy(x => x.Capability.Id).Take(10)){runtime.TryGetValue(entry.Capability.Id, out var activity);<a class="list-group-item list-group-item-action @(entry.Capability.RiskLevel.ToString() == "High" ? "lab-risk-high" : entry.Capability.RiskLevel.ToString() == "Medium" ? "lab-risk-medium" : "")" href="/capability-explorer?capabilityId=@Uri.EscapeDataString(entry.Capability.Id)"><div class="d-flex justify-content-between gap-3"><div class="text-truncate"><strong class="d-block text-truncate">@entry.Capability.Id</strong><small class="text-secondary">@entry.Capability.Provider · @entry.Capability.Category · @(string.IsNullOrWhiteSpace(entry.Capability.Owner) ? "Owner not recorded" : entry.Capability.Owner)</small></div><div class="text-end"><span class="badge bg-secondary-lt">@entry.Capability.RiskLevel risk</span><small class="d-block text-secondary mt-1">@(activity?.TotalRequests ?? 0) evaluations</small></div></div></a>}</div>}</section>
<aside class="d-flex flex-column gap-3"><section class="card"><div class="card-header"><h3 class="card-title">Most active</h3><a class="card-actions" href="/capability-activity">All activity</a></div>@if(Model.MostActiveCapabilities.Count==0){<div class="lab-empty"><strong>No capability activity</strong><span>Usage appears after evaluations are recorded.</span></div>}else{<div class="list-group list-group-flush">@foreach(var item in Model.MostActiveCapabilities.Take(6)){<a class="list-group-item list-group-item-action" href="/capability-activity?capabilityId=@Uri.EscapeDataString(item.CapabilityId)"><div class="lab-capability-row"><span class="text-truncate"><strong class="d-block text-truncate">@item.CapabilityId</strong><small class="text-secondary">@item.DeniedCount denied · @item.PendingApprovalCount pending</small></span><span class="progress progress-sm"><span class="progress-bar" style="width:@(item.TotalRequests*100/maxRequests)%"></span></span><strong class="text-end">@item.TotalRequests</strong></div></a>}</div>}</section>
<section class="card"><div class="card-header"><h3 class="card-title">Identity usage</h3><a class="card-actions" href="/identity-activity">All identities</a></div>@if(Model.Activity.Identities.Count==0){<div class="lab-empty"><strong>No identity activity</strong><span>No caller-to-capability usage has been observed.</span></div>}else{<div class="table-responsive"><table class="table table-sm card-table"><thead><tr><th>Identity</th><th>Capabilities</th><th>Requests</th></tr></thead><tbody>@foreach(var item in Model.Activity.Identities.OrderByDescending(x=>x.TotalRequests).Take(5)){<tr><td><a href="/identity-activity?identityId=@Uri.EscapeDataString(item.IdentityId)">@item.IdentityId</a></td><td>@item.DistinctCapabilitiesUsed.Count</td><td>@item.TotalRequests</td></tr>}</tbody></table></div>}</section></aside>
</div>
<section class="card mt-3"><div class="card-header"><h3 class="card-title">Recent capability decisions</h3><span class="text-secondary ms-auto">Policy and runtime evidence</span></div>@if(Model.Decisions.Count==0){<div class="lab-empty"><strong>No recent decisions</strong><span>No decision evidence is available for the capability inventory.</span></div>}else{<div class="table-responsive"><table class="table table-vcenter card-table lab-feed-table"><thead><tr><th>Capability</th><th class="lab-identity">Identity</th><th>Decision</th><th>Policy</th><th>Mode</th><th></th></tr></thead><tbody>@foreach(var item in Model.Decisions.Take(6)){<tr><td>@item.CapabilityId</td><td class="lab-identity">@item.IdentityId</td><td><span class="badge @DashboardLabModel.BadgeClass(item.Decision)">@DashboardLabModel.DecisionLabel(item.Decision)</span></td><td class="lab-reason">@(item.MatchedPolicies.FirstOrDefault() ?? "Default behavior / no match")</td><td>@item.EnforcementMode</td><td><a class="btn btn-sm" href="/audit/@Uri.EscapeDataString(item.Id)">Trace</a></td></tr>}</tbody></table></div>}</section>
</div></main>
