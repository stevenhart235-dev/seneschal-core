@page "/graph-view"
@model Seneschal.Api.Pages.GraphViewModel
@{
    Layout = null;
    var capability = Model.Overview?.CatalogEntry.Capability;
    var fallbackGroups = Model.GetFallbackRelationshipGroups();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Seneschal Relationship Graph</title>
    <link rel="stylesheet" href="/styles.css" />
    <script src="/vendor/d3/d3.v7.9.0.min.js"></script>
</head>
<body>
    <div class="app-shell">
        @await Html.PartialAsync("Shared/_PortalSidebar", "graph")

        <main class="container graph-page">
            <header class="page-header graph-page-header">
                <div>
                    <div class="breadcrumb">Explore / Relationship Graph</div>
                    <h1>Capability Relationship Graph</h1>
                    <p class="subtitle">
                        Explore identities, policies, and resources connected to one capability.
                    </p>
                </div>
                <a class="button-link" href="/capability-explorer">Back to Capability Explorer</a>
            </header>

            <form class="panel graph-capability-selector" method="get">
                <label for="capabilityId">Centered capability</label>
                <select id="capabilityId" name="capabilityId" onchange="this.form.submit()">
                    @foreach (var entry in Model.Capabilities)
                    {
                        var item = entry.Capability;
                        <option value="@item.Id" selected="@(string.Equals(item.Id, Model.CapabilityId, StringComparison.OrdinalIgnoreCase))">
                            @item.DisplayName (@item.Id)
                        </option>
                    }
                </select>
                <noscript><button type="submit">Load capability</button></noscript>
            </form>

            @if (capability is null)
            {
                <section class="panel empty-state graph-empty-state">
                    <h2>No capability graph available</h2>
                    <p class="muted">
                        Select a configured capability with projected relationships.
                    </p>
                </section>
            }
            else
            {
                <section class="graph-explorer-layout">
                    <article class="panel graph-panel">
                        <div class="graph-toolbar">
                            <div>
                                <h2>@capability.DisplayName</h2>
                                <p class="muted code">@capability.Id</p>
                            </div>
                            <div class="graph-toolbar-utilities">
                                <ul class="graph-legend" aria-label="Graph node type legend">
                                    <li><span class="legend-marker legend-capability"></span>Capability</li>
                                    <li><span class="legend-marker legend-identity"></span>Identity</li>
                                    <li><span class="legend-marker legend-policy"></span>Policy</li>
                                    <li><span class="legend-marker legend-resource"></span>Resource</li>
                                </ul>
                                <div class="graph-toolbar-actions" aria-label="Graph view controls">
                                    <button id="resetGraphButton" type="button">Reset</button>
                                    <button id="fitGraphButton" type="button">Fit</button>
                                </div>
                            </div>
                        </div>

                        <div
                            id="interactiveGraph"
                            class="interactive-graph d3-relationship-graph"
                            data-capability-id="@capability.Id"
                            role="img"
                            aria-label="Interactive relationship graph centered on @capability.DisplayName">
                        </div>

                        <div id="graphEmptyState" class="empty-state graph-empty-state" hidden>
                            <p class="muted">No relationships are available for this capability.</p>
                        </div>
                    </article>

                    <aside class="panel graph-inspector-panel" aria-label="Node details" aria-live="polite">
                        <div class="graph-inspector-header">
                            <div>
                                <h2>Node details</h2>
                                <p id="inspectorDefaultState" class="muted">Select a node to inspect it.</p>
                            </div>
                            <span id="inspectorTypeBadge" class="badge graph-inspector-type" hidden></span>
                        </div>
                        <div id="inspectorDetails" class="graph-inspector-details" hidden>
                            <h3 id="inspectorName"></h3>
                            <p id="inspectorId" class="code"></p>
                            <p id="inspectorDescription" class="muted"></p>
                            <dl id="inspectorMetadata" class="metadata-grid graph-metadata-grid"></dl>
                            <nav id="inspectorLinks" class="graph-inspector-links" aria-label="Node drill-down links"></nav>
                        </div>
                    </aside>
                </section>

                <section class="panel graph-accessible-fallback" aria-labelledby="relationshipListHeading">
                    <h2 id="relationshipListHeading">Relationship list</h2>
                    <p class="muted">Accessible non-graph view of the same projected relationships.</p>
                    @if (fallbackGroups.Count == 0)
                    {
                        <div class="empty-state"><p class="muted">No related identities, policies, or resources are available.</p></div>
                    }
                    else
                    {
                        <div class="relationship-compact-grid">
                            @foreach (var group in fallbackGroups)
                            {
                                <section class="relationship-group relationship-compact-group">
                                    <h3>Related @group.Type</h3>
                                    <ul class="relationship-compact-list">
                                        @foreach (var entityId in group.EntityIds)
                                        {
                                            <li><span class="relationship-chip">@entityId</span></li>
                                        }
                                    </ul>
                                </section>
                            }
                        </div>
                    }
                </section>
            }

            <footer class="app-footer">Seneschal v0.2.1-alpha</footer>
        </main>
    </div>
    <script src="/graph-view.js"></script>
</body>
</html>
