@page "/identity-explorer"
@model Seneschal.Api.Pages.IdentitiesModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Seneschal Identities</title>
    <link rel="stylesheet" href="/styles.css" />
</head>
<body>
    <div class="app-shell">
        @await Html.PartialAsync("Shared/_PortalSidebar", "identities")
        <main class="container explorer-page">
            <header class="page-header">
                <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/dashboard">Dashboard</a> / Identities</nav>
                <h1>Identities</h1>
                <p class="subtitle">Configured callers that can request governed capabilities.</p>
            </header>

            <section class="panel">
                <div class="section-header">
                    <div><h2>Configured identities</h2><p class="muted">@Model.Identities.Count identities loaded from configuration.</p></div>
                </div>
                <div class="table-scroll" tabindex="0" role="region" aria-label="Configured identities">
                    <table class="audit-table">
                        <thead><tr><th scope="col">Identity</th><th scope="col">Type</th><th scope="col">Governance context</th><th scope="col">Description</th><th scope="col">Activity</th></tr></thead>
                        <tbody>
                        @foreach (var identity in Model.Identities)
                        {
                            <tr>
                                <td>
                                    <strong>@(identity.DisplayName ?? identity.Name)</strong>
                                    @if (!string.IsNullOrWhiteSpace(identity.DisplayName))
                                    {
                                        <span class="code">@identity.Name</span>
                                    }
                                </td>
                                <td>@identity.Type</td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(identity.Owner))
                                    {
                                        <span><strong>Owner:</strong> @identity.Owner</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(identity.Application))
                                    {
                                        <span><strong>Application:</strong> @identity.Application</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(identity.Environment))
                                    {
                                        <span><strong>Environment:</strong> @identity.Environment</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(identity.Technology))
                                    {
                                        <span><strong>Technology:</strong> @identity.Technology</span>
                                    }
                                </td>
                                <td>@identity.Description</td>
                                <td><a href="/identity-activity?identityId=@Uri.EscapeDataString(identity.Name)">View activity</a></td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </section>
        </main>
    </div>
</body>
</html>
