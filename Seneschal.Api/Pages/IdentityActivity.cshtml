@page "/identity-activity"
@model Seneschal.Api.Pages.IdentityActivityModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Seneschal Identity Activity</title>
    <link rel="stylesheet" href="/styles.css" />
</head>
<body>
    <div class="app-shell">
        @await Html.PartialAsync("Shared/_PortalSidebar", "identity-activity")

        <main class="container explorer-page">
            <header class="page-header graph-page-header">
                <div>
                    <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/identity-explorer">Identities</a> / Identity Activity</nav>
                    <h1>Identity Activity</h1>
                    <p class="subtitle">
                        Understand which identities are most active and where
                        runtime decisions are denied or pending approval.
                    </p>
                </div>
                <a class="button-link" href="/identity-explorer">Back to Identities</a>
            </header>

            @if (!Model.HasActivity && !Model.IdentityWasRequested)
            {
                <section class="panel">
                    <h2>No Runtime Activity Yet</h2>
                    <div class="empty-state">
                        <p class="muted">
                            Identity activity appears automatically after
                            runtime evaluations are recorded.
                        </p>
                        <p class="muted">
                            Applications, middleware, the sample API, and users
                            create activity by calling
                            <span class="code">/evaluate</span>.
                        </p>
                    </div>
                </section>
            }
            else
            {
                <section class="panel">
                    <h2>Identities by Runtime Activity</h2>
                    <div class="table-scroll" tabindex="0" role="region" aria-label="Identity runtime activity">
                    <table class="activity-table">
                        <thead>
                            <tr>
                                <th scope="col">Identity</th>
                                <th scope="col">Total Requests</th>
                                <th scope="col">Distinct Capabilities</th>
                                <th scope="col">Denied</th>
                                <th scope="col">Pending Approval</th>
                                <th scope="col">Last Used</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var identity in Model.Identities)
                            {
                                <tr>
                                    <td>
                                        <a class="table-link" href="/identity-activity?identityId=@Uri.EscapeDataString(identity.IdentityId)">
                                            @identity.IdentityId
                                        </a>
                                    </td>
                                    <td>@identity.TotalRequests</td>
                                    <td>@identity.DistinctCapabilitiesUsed.Count</td>
                                    <td>@identity.DeniedCount</td>
                                    <td>@identity.PendingApprovalCount</td>
                                    <td>@(identity.LastUsedUtc?.ToString("u") ?? "n/a")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    </div>
                </section>

                @if (Model.IdentityWasRequested && Model.SelectedIdentity is null && Model.SelectedIdentityDefinition is null)
                {
                    <section class="notice">
                        <h2>Identity not found</h2>
                        <p class="muted">
                            No runtime activity was found for
                            <span class="code">@Model.IdentityId</span>.
                        </p>
                    </section>
                }
                else if (Model.SelectedIdentity is not null || Model.SelectedIdentityDefinition is not null)
                {
                    var identity = Model.SelectedIdentity ?? new Seneschal.Core.Models.IdentityActivity { IdentityId = Model.IdentityId! };
                    var definition = Model.SelectedIdentityDefinition;
                    <section class="panel identity-detail-panel investigation-actions-panel">
                        <div class="dashboard-section-header">
                            <div>
                                <h2>@(definition?.DisplayName ?? identity.IdentityId)</h2>
                                @if (!string.IsNullOrWhiteSpace(definition?.DisplayName))
                                {
                                    <span class="code">@identity.IdentityId</span>
                                }
                                <p class="muted">
                                    @(definition?.Description ?? "Runtime activity summary for the selected identity.")
                                </p>
                            </div>
                            <a class="button-link" href="/audit?identityId=@Uri.EscapeDataString(identity.IdentityId)">
                                Open Filtered Audit Trail
                            </a>
                        </div>

                        @if (definition is not null &&
                            (!string.IsNullOrWhiteSpace(definition.Owner) ||
                             !string.IsNullOrWhiteSpace(definition.Application) ||
                             !string.IsNullOrWhiteSpace(definition.Environment) ||
                             !string.IsNullOrWhiteSpace(definition.Technology)))
                        {
                            <dl class="evidence-list">
                                @if (!string.IsNullOrWhiteSpace(definition.Owner))
                                {
                                    <div><dt>Owner</dt><dd>@definition.Owner</dd></div>
                                }
                                @if (!string.IsNullOrWhiteSpace(definition.Application))
                                {
                                    <div><dt>Application</dt><dd>@definition.Application</dd></div>
                                }
                                @if (!string.IsNullOrWhiteSpace(definition.Environment))
                                {
                                    <div><dt>Environment</dt><dd>@definition.Environment</dd></div>
                                }
                                @if (!string.IsNullOrWhiteSpace(definition.Technology))
                                {
                                    <div><dt>Technology</dt><dd>@definition.Technology</dd></div>
                                }
                            </dl>
                        }

                        <section class="dashboard-grid activity-metric-grid">
                            <article class="dashboard-card activity-card">
                                <strong>@identity.TotalRequests</strong>
                                <span>Total Requests</span>
                            </article>
                            <article class="dashboard-card activity-card">
                                <strong>@identity.DistinctCapabilitiesUsed.Count</strong>
                                <span>Distinct Capabilities Used</span>
                            </article>
                            <article class="dashboard-card activity-card">
                                <strong>@identity.DeniedCount</strong>
                                <span>Denied Count</span>
                            </article>
                            <article class="dashboard-card activity-card">
                                <strong>@identity.PendingApprovalCount</strong>
                                <span>Pending Approval Count</span>
                            </article>
                        </section>

                        <section class="graph-inspector-section identity-exposure-analysis">
@if (Model.Exposure is not null) {
var exposure = Model.Exposure; var exposureSummary = exposure.Summary;
<h3>Governance Exposure Analysis</h3>
<p class="muted">Configured governance context describes current static policy and catalog relationships. Observed capability activity describes retained runtime evidence from @exposure.WindowStartUtc.ToString("u") through @exposure.WindowEndUtc.ToString("u"). Neither proves authorization or business necessity.</p><section class="notice evidence-coverage evidence-coverage-@exposure.Coverage.Status.ToString().ToLowerInvariant()"><h4>Evidence coverage: @exposure.Coverage.Status</h4><p>Requested: @exposure.WindowStartUtc.ToString("u") through @exposure.WindowEndUtc.ToString("u")</p>@if (exposure.Coverage.CompleteSinceUtc.HasValue) { <p>Continuous retained evidence begins: @exposure.Coverage.CompleteSinceUtc.Value.ToString("u")</p> }@if (exposure.Coverage.EarliestRelevantEvidenceUtc.HasValue) { <p>Earliest relevant evidence: @exposure.Coverage.EarliestRelevantEvidenceUtc.Value.ToString("u")<br />Latest relevant evidence: @exposure.Coverage.LatestRelevantEvidenceUtc!.Value.ToString("u")</p> }<p>@exposure.Coverage.Reason</p>@if (exposure.Coverage.Status != Seneschal.Api.Services.IdentityEvidenceCoverageStatus.Full) { <p><strong>No observed use means no use found in retained evidence for this period; absence outside proven coverage cannot be determined.</strong></p> }</section>
<section class="panel configuration-provenance"><h4>Governance configuration provenance</h4><dl class="evidence-list"><div><dt>Current configuration</dt><dd>@(exposure.ConfigurationProvenance.CurrentFingerprint ?? "Unavailable")</dd></div><div><dt>Distinct evaluation configurations</dt><dd>@exposure.ConfigurationProvenance.ObservedFingerprints.Count</dd></div><div><dt>Events without provenance</dt><dd>@exposure.ConfigurationProvenance.UnavailableEventCount</dd></div><div><dt>Current comparison</dt><dd>@if (exposure.ConfigurationProvenance.ObservedFingerprints.Count == 0) { <span>No fingerprinted events in period</span> } else if (exposure.ConfigurationProvenance.AllAvailableMatchCurrent) { <span>All recorded configurations match current</span> } else { <span>One or more recorded configurations differ from current or are unavailable</span> }</dd></div></dl>@if (exposure.ConfigurationProvenance.ObservedFingerprints.Count > 0) { <details><summary>Recorded fingerprints</summary><ul>@foreach (var fingerprint in exposure.ConfigurationProvenance.ObservedFingerprints) { <li><code>@fingerprint</code> — @(string.Equals(fingerprint, exposure.ConfigurationProvenance.CurrentFingerprint, StringComparison.Ordinal) ? "Same as current" : "Different from current")</li> }</ul><p class="muted">A difference means evaluation-relevant governance configuration changed. It does not identify a specific policy change or prove the decision would now differ.</p></details> }</section>
<section class="dashboard-grid activity-metric-grid" aria-label="Exposure summary">
<article class="dashboard-card activity-card"><strong>@exposureSummary.ConfiguredCount</strong><span>Configured governance capabilities</span></article>
<article class="dashboard-card activity-card"><strong>@exposureSummary.ObservedCount</strong><span>Observed capabilities</span></article>
<article class="dashboard-card activity-card"><strong>@exposureSummary.ConfiguredAndObservedCount</strong><span>Configured + observed</span></article>
<article class="dashboard-card activity-card"><strong>@exposureSummary.ConfiguredNotObservedCount</strong><span>@(exposure.Coverage.Status == Seneschal.Api.Services.IdentityEvidenceCoverageStatus.Full ? "No observed use in selected period" : "No observed use found in retained evidence")</span></article>
<article class="dashboard-card activity-card"><strong>@exposureSummary.ObservedNotConfiguredCount</strong><span>Observed outside current configured governance context</span></article>
</section>
<section class="panel exposure-findings" aria-labelledby="exposure-findings-title"><div class="capability-section-header"><div><h4 id="exposure-findings-title">Explainable Exposure Findings</h4><p>Deterministic interpretations of current governance facts and retained evidence. Findings are not recommendations or scores.</p></div><span>@Model.Findings.Count finding(s)</span></div>
@if (Model.Findings.Count == 0) { <div class="empty-state"><strong>No findings for this identity and period</strong><p>Exposure facts remain available below. Unknown coverage suppresses absence findings.</p></div> } else { <div class="capability-relationship-groups">@foreach (var finding in Model.Findings) { <details class="exposure-finding finding-@finding.FindingType.ToString().ToLowerInvariant()"><summary><span>@finding.Title</span><span class="badge risk-badge risk-@finding.CapabilityRisk.ToLowerInvariant()">@finding.CapabilityRisk</span></summary><div><code>@finding.FindingType</code><p>@finding.Explanation</p><p><strong>What this does not prove:</strong> @finding.WhatThisDoesNotProve</p><dl class="evidence-list"><div><dt>Capability</dt><dd><a href="/capability-explorer?capabilityId=@Uri.EscapeDataString(finding.CapabilityId)">@finding.CapabilityId</a></dd></div><div><dt>Technology</dt><dd>@(string.IsNullOrWhiteSpace(finding.Technology) ? "Not specified" : finding.Technology)</dd></div><div><dt>Evidence coverage</dt><dd>@finding.EvidenceCoverageStatus</dd></div><div><dt>Observation window</dt><dd>@finding.WindowStartUtc.ToString("u") through @finding.WindowEndUtc.ToString("u")</dd></div><div><dt>Capability source</dt><dd>@finding.CapabilityProvenance</dd></div></dl><h5>Supporting facts</h5><dl class="evidence-list">@foreach (var fact in finding.SupportingFacts) { <div><dt>@fact.Label</dt><dd>@fact.Value</dd></div> }</dl><nav class="investigation-actions" aria-label="Finding investigation links"><a href="/capability-activity?capabilityId=@Uri.EscapeDataString(finding.CapabilityId)&identity=@Uri.EscapeDataString(finding.IdentityId)">View capability evidence</a>@foreach (var policy in exposure.AllItems.First(item => string.Equals(item.CapabilityId, finding.CapabilityId, StringComparison.OrdinalIgnoreCase)).Policies) { <a href="/policies?policyId=@Uri.EscapeDataString(policy)">@policy</a> }</nav>@if (finding.ObservedConfigurationFingerprints.Count > 0) { <details><summary>Configuration provenance</summary><p>Current: <code>@(finding.CurrentConfigurationFingerprint ?? "Unavailable")</code></p><ul>@foreach (var fingerprint in finding.ObservedConfigurationFingerprints) { <li><code>@fingerprint</code></li> }</ul>@if (finding.ObservationsWithoutConfigurationProvenance > 0) { <p>@finding.ObservationsWithoutConfigurationProvenance observation(s) have unavailable configuration provenance.</p> }</details> }</div></details> }</div> }
</section>
<div class="dashboard-columns"><section><h4>Critical risk context</h4><dl class="evidence-list"><div><dt>Configured</dt><dd>@exposureSummary.CriticalConfiguredCount</dd></div><div><dt>With observed use</dt><dd>@exposureSummary.CriticalObservedCount</dd></div><div><dt>No observed use in selected period</dt><dd>@exposureSummary.CriticalNotObservedCount</dd></div></dl></section><section><h4>Technology context</h4><ul class="compact-list">@foreach (var technology in exposureSummary.Technologies) { <li><strong>@technology.Technology</strong><span>@technology.ConfiguredCount configured / @technology.ObservedCount observed</span></li> }</ul></section></div>
<form method="get" action="/identity-activity" class="search-panel"><input type="hidden" name="identityId" value="@Model.IdentityId" /><div class="search-row capability-filter-row"><label>Observation period<select name="days">@foreach (var value in new[] { 7, 30, 60, 90, 180, 365 }) { <option value="@value" selected="@(Model.ObservationDays == value)">Last @value days</option> }</select></label><label>Exposure state<select name="exposureState"><option value="">All states</option>@foreach (var value in Enum.GetNames<Seneschal.Api.Services.IdentityExposureState>()) { <option value="@value" selected="@(string.Equals(Model.ExposureStateFilter, value, StringComparison.OrdinalIgnoreCase))">@StateLabel(value)</option> }</select></label><label>Risk<select name="exposureRisk"><option value="">All risk levels</option>@foreach (var value in new[] { "Critical", "High", "Medium", "Low" }) { <option value="@value" selected="@(string.Equals(Model.ExposureRiskFilter, value, StringComparison.OrdinalIgnoreCase))">@value</option> }</select></label><label>Technology<input name="exposureTechnology" value="@Model.ExposureTechnologyFilter" /></label><button type="submit">Apply filters</button></div></form>
@if (exposure.Items.Count == 0) { <div class="empty-state"><strong>No capabilities match these filters</strong><p>Change or clear filters while preserving the selected identity and period.</p></div> } else {
<div class="table-scroll" tabindex="0" role="region" aria-label="Identity governance exposure"><table class="activity-table"><thead><tr><th>Capability</th><th>State</th><th>Technology</th><th>Category</th><th>Risk</th><th>Configured policies</th><th>Decision / environment</th><th>Observed evaluations</th><th>Most recent</th><th>Source</th></tr></thead><tbody>
@foreach (var item in exposure.Items) { <tr><td><a href="/capability-explorer?capabilityId=@Uri.EscapeDataString(item.CapabilityId)">@item.DisplayName</a><br /><code>@item.CapabilityId</code></td><td>@StateLabel(item.State.ToString())</td><td>@(string.IsNullOrWhiteSpace(item.Technology) ? "Not specified" : item.Technology)</td><td>@(string.IsNullOrWhiteSpace(item.Category) ? "Not specified" : item.Category)</td><td><span class="badge risk-badge risk-@item.Risk.ToLowerInvariant()">@item.Risk</span></td><td>@if (item.Policies.Count == 0) { <span>None in current context</span> } else { @foreach (var policy in item.Policies) { <a href="/policies?policyId=@Uri.EscapeDataString(policy)">@policy</a><br /> } }</td><td>@(item.Decisions.Count == 0 ? "Not configured" : string.Join(", ", item.Decisions))<br /><span class="muted">@(item.Environments.Count == 0 ? "No configured environment" : string.Join(", ", item.Environments))</span></td><td>@item.ObservedCount @if (item.ObservedCount > 0) { <br /><a href="/capability-activity?capabilityId=@Uri.EscapeDataString(item.CapabilityId)&identity=@Uri.EscapeDataString(Model.IdentityId!)">View evidence</a> }</td><td>@(item.MostRecentObservedUtc?.ToString("u") ?? "No observed use")</td><td>@item.Provenance</td></tr> }
</tbody></table></div> }
}
</section>
<section class="graph-inspector-section">
                            <h3>Observed Capability Activity</h3>
                            @if (identity.DistinctCapabilitiesUsed.Count == 0)
                            {
                                <p class="muted">
                                    No capabilities have been observed for this
                                    identity yet.
                                </p>
                            }
                            else
                            {
                                <ul class="compact-list identity-capability-list">
                                    @foreach (var capability in identity.DistinctCapabilitiesUsed)
                                    {
                                        <li>
                                            <a href="/capability-explorer?capabilityId=@Uri.EscapeDataString(capability)">
                                                @capability
                                            </a>
                                            <span>View capability profile</span>
                                        </li>
                                    }
                                </ul>
                            }
                        </section>

                        <section class="graph-inspector-section">
                            <h3>Recent Evaluations</h3>
                            @if (Model.RecentEvidence.Count == 0)
                            {
                                <div class="empty-state"><strong>No recent activity</strong><p>Evaluations will appear here after this identity is observed.</p></div>
                            }
                            else
                            {
                                <div class="table-scroll" tabindex="0" role="region" aria-label="Recent identity evaluations">
                                    <table class="activity-table"><thead><tr><th>Time</th><th>Capability</th><th>Environment</th><th>Decision</th><th>Runtime mode</th><th>Operation ID</th><th>Investigation</th></tr></thead><tbody>
                                    @foreach (var evidence in Model.RecentEvidence)
                                    {
                                        var decision = evidence.Decision == Seneschal.Core.Enums.DecisionType.RequireApproval ? "Pending Approval" : evidence.Decision.ToString();
                                        <tr><td><time datetime="@evidence.TimestampUtc.ToString("O")">@evidence.TimestampUtc.ToString("u")</time></td><td><a href="/capability-activity?capabilityId=@Uri.EscapeDataString(evidence.CapabilityId)">@evidence.CapabilityId</a></td><td>@(string.IsNullOrWhiteSpace(evidence.Environment) ? "Not provided" : evidence.Environment)</td><td><span class="decision-badge decision-@decision.Replace(" ", "").ToLowerInvariant()">@decision</span></td><td>@evidence.EnforcementMode</td><td><code>@(evidence.ApprovalOperationId ?? "—")</code></td><td><a href="/audit/@Uri.EscapeDataString(evidence.Id)">View Decision Trace</a></td></tr>
                                    }
                                    </tbody></table>
                                </div>
                            }
                        </section>
                    </section>
                }
            }

            <footer class="app-footer">Seneschal v0.2.1-alpha</footer>
        </main>
    </div>
</body>
</html>

@functions {
private static string StateLabel(string value) => value switch {
"ConfiguredAndObserved" => "Configured + observed",
"ConfiguredNotObserved" => "No observed use in selected period",
"ObservedNotConfigured" => "Observed outside current configured governance context",
_ => value };
}