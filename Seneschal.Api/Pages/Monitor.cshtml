@page "/monitor"
@model Seneschal.Api.Pages.MonitorModel
@using Seneschal.Core.Enums
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Live Monitor</title>
    <link rel="stylesheet" href="/styles.css" />
</head>
<body>
<div class="app-shell">
    @await Html.PartialAsync("Shared/_PortalSidebar", "monitor")
    <main id="monitor-console" class="container explorer-page monitor-console" data-generated-at="@Model.GeneratedAtUtc.ToString("O")">
        <header class="page-header monitor-page-header">
            <div><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/dashboard">Dashboard</a> / Live Monitor</nav><h1>Live Monitor</h1><p class="subtitle">Watch current evaluations, runtime health, and events requiring attention.</p></div>
            <a class="table-link" href="/dashboard">Open Dashboard</a>
        </header>

        <section class="monitor-status-strip @(Model.CanonicalRuntimeMode == "Enforce" ? "is-enforcing" : "is-monitoring")" aria-label="Current operational status">
            <article><span>Operational health</span><strong><i class="monitor-health-dot" aria-hidden="true"></i>@(Model.SeneschalHealthy ? "Healthy" : "Needs attention")</strong></article>
            <article><span>Runtime mode</span><strong>@Model.CanonicalRuntimeMode</strong><small>@(Model.CanonicalRuntimeMode == "Enforce" ? "Enforcement active" : "Monitoring active")</small></article>
            <article><span>Polling state</span><strong id="monitor-polling-status"><i class="live-indicator" aria-hidden="true"></i> Current · 3s</strong></article>
            <article><span>Last successful evaluation</span><strong>@if (Model.LastEvaluationUtc is null) { <span>No evaluations observed</span> } else { <time data-relative-time datetime="@Model.LastEvaluationUtc.Value.ToString("O")">@Model.LastEvaluationUtc.Value.ToString("u")</time> }</strong></article>
            <article><span>Governance window</span><strong>@(Model.GovernanceWindow.Enabled ? Model.GovernanceWindow.Name : "None active")</strong><small>@(Model.GovernanceWindow.Enabled ? Model.GovernanceWindow.Mode : "No active window")</small></article>
        </section>

        <section class="monitor-metrics" aria-label="Live runtime metrics">
            <article><span>Evaluations · 5 min</span><strong>@Model.RecentEvaluationCount</strong></article>
            <article><span>Allow</span><strong class="metric-allow">@Model.RecentAllowCount</strong></article>
            <article><span>Deny</span><strong class="metric-deny">@Model.RecentDenyCount</strong></article>
            <article><span>Pending approval</span><strong class="metric-pending">@Model.RecentPendingCount</strong></article>
            <article><span>Average latency</span><strong>@Model.RecentAverageLatencyMs.ToString("0.##") <small>ms</small></strong></article>
            <article><span>Active identities</span><strong>@Model.ActiveIdentityCount</strong></article>
            <article><span>Active capabilities</span><strong>@Model.ActiveCapabilityCount</strong></article>
        </section>

        <section class="panel monitor-stream monitor-stream-hero" aria-labelledby="decision-stream-title">
                <header class="monitor-section-header"><div><h2 id="decision-stream-title">Live decision stream</h2><p>Most recent runtime evaluations, newest first.</p></div><a href="/audit">Open Audit Trail</a></header>
                <div class="monitor-stream-columns" aria-hidden="true"><span>Time</span><span>Identity / application</span><span>Capability</span><span>Decision</span><span>Effective action</span><span>Correlation</span><span>Investigation</span></div>
                @if (Model.RecentEvaluations.Count == 0)
                {
                    <div class="empty-state"><strong>No runtime evaluations observed</strong><p>Decision activity appears here when an integrated application calls Seneschal.</p></div>
                }
                else
                {
                    <ol class="monitor-event-list">
                    @foreach (var item in Model.RecentEvaluations)
                    {
                        var decision = DecisionLabel(item.Decision);
                        var effective = EffectiveResult(item.Decision, item.EnforcementMode);
                        <li class="monitor-event-row">
                            <time data-relative-time datetime="@item.TimestampUtc.ToString("O")">@item.TimestampUtc.ToString("u")</time>
                            <div class="monitor-event-identity"><a href="/identity-activity?identityId=@Uri.EscapeDataString(item.IdentityId)">@item.IdentityId</a></div>
                            <div class="monitor-event-capability"><a href="/capability-explorer?capabilityId=@Uri.EscapeDataString(item.CapabilityId)" aria-label="View capability profile for @item.CapabilityId">@item.CapabilityId</a></div>
                            <span class="decision-badge decision-@DecisionClass(item.Decision)">@decision</span>
                            <span class="effective-result effective-@EffectiveClass(effective)">@effective</span>
                            <div class="monitor-event-context">
                                @if (!string.IsNullOrWhiteSpace(item.GovernanceWindowName)) { <span class="window-participation">Window: @item.GovernanceWindowName (@item.GovernanceWindowMode)</span> }
                                @if (!string.IsNullOrWhiteSpace(item.ApprovalOperationId)) { <code title="Application operation ID">@item.ApprovalOperationId</code> }
                                @if (string.IsNullOrWhiteSpace(item.GovernanceWindowName) && string.IsNullOrWhiteSpace(item.ApprovalOperationId)) { <span>—</span> }
                            </div>
                            <a class="monitor-trace-link" href="/capability-activity?capabilityId=@Uri.EscapeDataString(item.CapabilityId)&amp;identity=@Uri.EscapeDataString(item.IdentityId)&amp;environment=@Uri.EscapeDataString(item.Environment)&amp;runtimeMode=@Uri.EscapeDataString(item.EnforcementMode.ToString())">Investigate Capability Activity</a>
                        </li>
                    }
                    </ol>
                }
        </section>
        <noscript><p class="warning-panel">Live refresh requires JavaScript. Reload this page to update operational state.</p></noscript>
        <footer class="app-footer">Seneschal v0.2.1-alpha</footer>
    </main>
</div>
<script src="/monitor-live.js"></script>
</body>
</html>

@functions {
    private static string DecisionLabel(DecisionType decision) => decision == DecisionType.RequireApproval ? "Pending Approval" : decision.ToString();
    private static string DecisionClass(DecisionType decision) => decision == DecisionType.RequireApproval ? "pending" : decision.ToString().ToLowerInvariant();
    private static string EffectiveResult(DecisionType decision, EnforcementMode mode) => decision switch { DecisionType.Allow => "Caller may proceed", DecisionType.RequireApproval when mode == EnforcementMode.Enforce => "Caller should pause and retry", DecisionType.Deny when mode == EnforcementMode.Enforce => "Caller should block the operation", _ => "Recorded; caller may continue" };
    private static string EffectiveClass(string effective) => effective switch { "Caller may proceed" => "executed", "Recorded; caller may continue" => "recorded", "Caller should pause and retry" => "pending-blocked", _ => "blocked" };
}
