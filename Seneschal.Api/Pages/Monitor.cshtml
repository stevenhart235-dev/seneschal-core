@page "/monitor"
@model Seneschal.Api.Pages.MonitorModel
@using Seneschal.Core.Enums
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Seneschal Monitor</title>
    <link rel="stylesheet" href="/styles.css" />
</head>
<body>
<div class="app-shell">
    @await Html.PartialAsync("Shared/_PortalSidebar", "monitor")
    <main id="monitor-console" class="container explorer-page monitor-console" data-generated-at="@Model.GeneratedAtUtc.ToString("O")">
        <header class="page-header monitor-page-header">
            <div><div class="breadcrumb">Overview / Monitor</div><h1>Monitor</h1><p class="subtitle">Live operational state across the Seneschal runtime.</p></div>
            <a class="table-link" href="/dashboard">Open Dashboard</a>
        </header>

        <section class="monitor-posture @(Model.CanonicalRuntimeMode == "Enforce" ? "is-enforcing" : "is-monitoring")" aria-labelledby="monitor-posture-title">
            <div class="monitor-posture-primary">
                <span class="monitor-eyebrow">Operational status</span>
                <div class="monitor-health-line"><span class="monitor-health-dot" aria-hidden="true"></span><strong id="monitor-posture-title">@(Model.SeneschalHealthy ? "Healthy" : "Configuration requires attention")</strong></div>
                <div class="monitor-mode-line"><span>@(Model.CanonicalRuntimeMode == "Enforce" ? "Enforcement active" : "Monitoring active")</span><small>Canonical mode: <b>@Model.CanonicalRuntimeMode</b></small></div>
                <p>@Model.OperationalSummary</p>
            </div>
            <dl class="monitor-posture-context">
                <div><dt>Governance windows</dt><dd>@(Model.GovernanceWindow.Enabled ? $"{Model.GovernanceWindow.Name} · {Model.GovernanceWindow.Mode}" : "None active")</dd></div>
                <div><dt>Last successful evaluation</dt><dd>@if (Model.LastEvaluationUtc is null) { <span>No evaluations observed</span> } else { <time data-relative-time datetime="@Model.LastEvaluationUtc.Value.ToString("O")">@Model.LastEvaluationUtc.Value.ToString("u")</time> }</dd></div>
                <div><dt>Polling</dt><dd id="monitor-polling-status"><span class="live-indicator" aria-hidden="true"></span> Current · every 3 seconds</dd></div>
                <div class="monitor-posture-links"><dt>Controls</dt><dd><a href="/governance">Runtime Governance</a><a href="/governance-windows">Governance Windows</a></dd></div>
            </dl>
        </section>

        <section class="monitor-metrics" aria-label="Live runtime metrics">
            <article><span>Evaluations · 5 min</span><strong>@Model.RecentEvaluationCount</strong></article>
            <article><span>Allow</span><strong class="metric-allow">@Model.RecentAllowCount</strong></article>
            <article><span>Deny</span><strong class="metric-deny">@Model.RecentDenyCount</strong></article>
            <article><span>Pending approval</span><strong class="metric-pending">@Model.RecentPendingCount</strong></article>
            <article><span>Average latency</span><strong>@Model.RecentAverageLatencyMs.ToString("0.##") <small>ms</small></strong></article>
            <article><span>Active identities</span><strong>@Model.ActiveIdentityCount</strong></article>
            <article><span>Active capabilities</span><strong>@Model.ActiveCapabilityCount</strong></article>
        </section>

        <div class="monitor-workspace">
            <section class="panel monitor-stream" aria-labelledby="decision-stream-title">
                <header class="monitor-section-header"><div><h2 id="decision-stream-title">Live decision stream</h2><p>Most recent runtime evaluations, newest first.</p></div><a href="/audit">Open Audit Trail</a></header>
                @if (Model.RecentEvaluations.Count == 0)
                {
                    <div class="empty-state"><strong>No runtime evaluations observed</strong><p>Decision activity appears here when an integrated application calls Seneschal.</p></div>
                }
                else
                {
                    <ol class="monitor-event-list">
                    @foreach (var item in Model.RecentEvaluations)
                    {
                        var decision = DecisionLabel(item.Decision);
                        var effective = EffectiveResult(item.Decision, item.EnforcementMode);
                        <li class="monitor-event-row">
                            <time data-relative-time datetime="@item.TimestampUtc.ToString("O")">@item.TimestampUtc.ToString("u")</time>
                            <div class="monitor-event-subject"><a href="/identity-activity?identityId=@Uri.EscapeDataString(item.IdentityId)">@item.IdentityId</a><a href="/capability-activity?capabilityId=@Uri.EscapeDataString(item.CapabilityId)">@item.CapabilityId</a></div>
                            <div class="monitor-event-outcome"><span class="decision-badge decision-@DecisionClass(item.Decision)">@decision</span><span class="effective-result effective-@EffectiveClass(effective)">→ @effective</span></div>
                            <div class="monitor-event-context">
                                @if (!string.IsNullOrWhiteSpace(item.GovernanceWindowName)) { <span class="window-participation">Window: @item.GovernanceWindowName (@item.GovernanceWindowMode)</span> }
                                @if (!string.IsNullOrWhiteSpace(item.ApprovalOperationId)) { <code title="Application operation ID">@item.ApprovalOperationId</code> }
                            </div>
                            <a class="monitor-trace-link" href="/audit/@Uri.EscapeDataString(item.Id)">View trace</a>
                        </li>
                    }
                    </ol>
                }
            </section>

            <aside class="monitor-side-column">
                <section class="panel monitor-attention" aria-labelledby="attention-title">
                    <header class="monitor-section-header"><div><h2 id="attention-title">Attention</h2><p>Current signals worth reviewing.</p></div></header>
                    <a class="monitor-attention-item @(Model.CurrentPendingApprovalCount > 0 ? "has-attention" : "")" href="/approvals"><span>Pending approvals</span><strong>@Model.CurrentPendingApprovalCount</strong><small>@(Model.CurrentPendingApprovalCount > 0 ? "Awaiting human resolution" : "No requests waiting")</small></a>
                    <a class="monitor-attention-item @(Model.MostDeniedCapability is not null ? "has-critical" : "")" href="@(Model.MostDeniedCapability is null ? "/capability-activity" : $"/capability-activity?capabilityId={Uri.EscapeDataString(Model.MostDeniedCapability.CapabilityId)}")"><span>Most denied capability</span><strong>@(Model.MostDeniedCapability?.DeniedCount ?? 0)</strong><small>@(Model.MostDeniedCapability?.CapabilityId ?? "No denied capability observed")</small></a>
                    <a class="monitor-attention-item" href="@(Model.MostActiveIdentity is null ? "/identity-activity" : $"/identity-activity?identityId={Uri.EscapeDataString(Model.MostActiveIdentity.IdentityId)}")"><span>Most active identity</span><strong>@(Model.MostActiveIdentity?.TotalRequests ?? 0)</strong><small>@(Model.MostActiveIdentity?.IdentityId ?? "No identity activity observed")</small></a>
                    <a class="monitor-attention-item @(Model.GovernanceWindow.Enabled ? "has-attention" : "")" href="/governance-windows"><span>Active governance windows</span><strong>@(Model.GovernanceWindow.Enabled ? 1 : 0)</strong><small>@(Model.GovernanceWindow.Enabled ? $"{Model.GovernanceWindow.Name} · {Model.GovernanceWindow.Mode}" : "None active")</small></a>
                    <div class="monitor-incidents"><div><span>Recent incidents</span><a href="/incidents">View all</a></div>@if (Model.RecentIncidents.Count == 0) { <p>No incidents recorded.</p> } else { <ul>@foreach (var incident in Model.RecentIncidents) { <li><a href="/incidents/@Uri.EscapeDataString(incident.Id)">@incident.Title</a><small>@incident.LastSeenUtc.ToString("u")</small></li> }</ul> }</div>
                </section>

                <section class="panel monitor-runtime-health" aria-labelledby="runtime-health-title">
                    <header class="monitor-section-header"><div><h2 id="runtime-health-title">Runtime health</h2><p>Observed runtime responsiveness.</p></div></header>
                    <div class="runtime-health-state"><span class="monitor-health-dot" aria-hidden="true"></span><div><strong>@(Model.SeneschalHealthy ? "Seneschal is responding" : "Configuration requires attention")</strong><small>@(Model.EvaluationsFlowing ? "Evaluations are flowing" : Model.LastEvaluationUtc is null ? "Waiting for evaluation traffic" : "No evaluation in the last 20 seconds")</small></div></div>
                    <dl><div><dt>Observed latency</dt><dd>@Model.RecentAverageLatencyMs.ToString("0.##") ms average</dd></div><div><dt>Current range</dt><dd>@Model.RecentMinimumLatencyMs–@Model.RecentMaximumLatencyMs ms</dd></div><div><dt>Polling evidence</dt><dd id="monitor-health-polling">Current</dd></div></dl>
                    <a href="/diagnostics">Open Diagnostics</a>
                </section>
            </aside>
        </div>
        <noscript><p class="warning-panel">Live refresh requires JavaScript. Reload this page to update operational state.</p></noscript>
        <footer class="app-footer">Seneschal v0.2.1-alpha</footer>
    </main>
</div>
<script src="/monitor-live.js"></script>
</body>
</html>

@functions {
    private static string DecisionLabel(DecisionType decision) => decision == DecisionType.RequireApproval ? "Pending Approval" : decision.ToString();
    private static string DecisionClass(DecisionType decision) => decision == DecisionType.RequireApproval ? "pending" : decision.ToString().ToLowerInvariant();
    private static string EffectiveResult(DecisionType decision, EnforcementMode mode) => decision switch { DecisionType.Allow => "Executed", DecisionType.RequireApproval when mode == EnforcementMode.Enforce => "Blocked pending approval", DecisionType.Deny when mode == EnforcementMode.Enforce => "Blocked", _ => "Executed and recorded" };
    private static string EffectiveClass(string effective) => effective switch { "Executed" => "executed", "Executed and recorded" => "recorded", "Blocked pending approval" => "pending-blocked", _ => "blocked" };
}
