@page "/proposed-change-review"
@model Seneschal.Api.Pages.ProposedChangeReviewModel
@{ Layout=null; var review=Model.Review!; var item=review.ExposureItem; }
<!DOCTYPE html><html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" /><title>Proposed Governance Change Review</title><link rel="stylesheet" href="/styles.css" /></head><body><div class="app-shell">@await Html.PartialAsync("Shared/_PortalSidebar", "identity-activity")<main class="container explorer-page">
<header class="page-header"><div><nav class="breadcrumb"><a href="/identity-activity?identityId=@Uri.EscapeDataString(review.IdentityId)">Identity Activity</a> / Proposed Change Review</nav><h1>Proposed Governance Change Review</h1><p class="subtitle">Evidence-to-simulation review for a hypothetical governance change.</p></div></header>
<section class="notice"><h2>PROPOSED — NOT APPLIED</h2><p><strong>This review is read-only. Seneschal has not changed active governance.</strong></p></section>
@if(review.Candidate.Proposal is not null && review.Simulation?.IsValid==true){var predicted=review.Simulation; var predictedProposal=review.Candidate.Proposal;<section class="panel predicted-effect" aria-labelledby="predicted-effect-title"><div class="capability-section-header"><div><h2 id="predicted-effect-title">Predicted effect</h2><p>Derived from the current and proposed canonical simulation results.</p></div><span class="badge status-badge">@predicted.RuntimeMode</span></div><p>The proposed <strong>@predictedProposal.Change.Operation</strong> would change this evaluated policy decision from <strong>@predicted.Current!.Decision</strong> to <strong>@predicted.Proposed!.Decision</strong>. With <strong>@predicted.RuntimeMode</strong> active for this simulation, integration guidance changes from <strong>@predicted.Current.ExecutionGuidance</strong> to <strong>@predicted.Proposed.ExecutionGuidance</strong>. The proposed evaluation @(predicted.Proposed.ShouldProceed ? "would permit immediate execution according to canonical guidance" : "would not authorize immediate execution according to canonical guidance").</p><dl class="evidence-list"><div><dt>Runtime mode</dt><dd>@predicted.RuntimeMode</dd></div><div><dt>Policy decision</dt><dd>@predicted.Current.Decision → @predicted.Proposed.Decision</dd></div><div><dt>Execution Guidance</dt><dd>@predicted.Current.ExecutionGuidance → @predicted.Proposed.ExecutionGuidance</dd></div><div><dt>ShouldProceed</dt><dd>@(predicted.Current.ShouldProceed ? "Yes":"No") → @(predicted.Proposed.ShouldProceed ? "Yes":"No")</dd></div><div><dt>Status</dt><dd><strong>PROPOSED — NOT APPLIED</strong></dd></div></dl><p><strong>No governance changes have been applied.</strong></p></section>}
<section class="panel"><h2>Source</h2><dl class="evidence-list"><div><dt>Identity</dt><dd>@review.IdentityId</dd></div><div><dt>Capability</dt><dd>@review.CapabilityId</dd></div><div><dt>Technology</dt><dd>@(item?.Technology ?? "Not specified")</dd></div><div><dt>Curated risk</dt><dd>@(item?.Risk ?? "Unknown")</dd></div><div><dt>Capability provenance</dt><dd>@(item?.Provenance ?? "Unknown")</dd></div></dl></section>
<section class="panel"><h2>1. Evidence</h2><dl class="evidence-list"><div><dt>Observation window</dt><dd>@review.Exposure.WindowStartUtc.ToString("u") through @review.Exposure.WindowEndUtc.ToString("u")</dd></div><div><dt>Evidence coverage</dt><dd>@review.Exposure.Coverage.Status</dd></div><div><dt>Observation count</dt><dd>@(item?.ObservedCount ?? 0)</dd></div><div><dt>Current configuration</dt><dd><code>@(review.Exposure.ConfigurationProvenance.CurrentFingerprint ?? "Unavailable")</code></dd></div></dl></section>
@if(review.Finding is not null){<section class="panel"><h2>2. Finding</h2><h3>@review.Finding.Title</h3><p>@review.Finding.Explanation</p><p><strong>What this does not prove:</strong> @review.Finding.WhatThisDoesNotProve</p></section>}
@if(review.Recommendation is not null){<section class="panel"><h2>3. Recommendation</h2><h3>@review.Recommendation.Title</h3><p><strong>Consider:</strong> @review.Recommendation.SuggestedNextStep</p><p><strong>Why:</strong> @review.Recommendation.Explanation</p><p><strong>Advisory limitation:</strong> @review.Recommendation.EvidenceLimitations</p></section>}
@if(!review.Candidate.IsAvailable){<section class="notice"><h2>4. Candidate proposed change</h2><strong>No deterministic candidate proposed change is available.</strong><p>@review.Candidate.Reason</p></section>}
else { var proposal=review.Candidate.Proposal!;<section class="panel"><h2>4. Candidate proposed change</h2><p><strong>HYPOTHETICAL — NOT APPLIED</strong></p><dl class="evidence-list"><div><dt>Operation</dt><dd>@proposal.Change.Operation</dd></div><div><dt>Policy</dt><dd>@proposal.Change.Policy</dd></div><div><dt>Capability</dt><dd>@proposal.Change.Capability</dd></div><div><dt>Base configuration</dt><dd><code>@proposal.BaseGovernanceConfigurationFingerprint</code></dd></div></dl></section>
@if(review.IsStale){<section class="notice"><h2>STALE PROPOSAL</h2><p>Base configuration changed after this candidate was produced.</p><p>Regenerate the proposal before simulation.</p></section>}
else if(review.Simulation?.IsValid==true){var sim=review.Simulation;<section class="panel"><h2>5. Current vs proposed evaluation</h2><div class="dashboard-columns"><section><h3>CURRENT</h3><dl class="evidence-list"><div><dt>Decision</dt><dd>@sim.Current!.Decision</dd></div><div><dt>Execution Guidance</dt><dd>@sim.Current.ExecutionGuidance</dd></div><div><dt>ShouldProceed</dt><dd>@(sim.Current.ShouldProceed ? "Yes":"No")</dd></div><div><dt>Winning policy</dt><dd>@sim.Current.WinningPolicy</dd></div><div><dt>Reason</dt><dd>@sim.Current.Reason</dd></div><div><dt>Approval state</dt><dd>@(sim.Current.ApprovalStatus??"Not applicable")</dd></div><div><dt>Active fingerprint</dt><dd><code>@sim.CurrentGovernanceConfigurationFingerprint</code></dd></div></dl></section><section><h3>PROPOSED</h3><dl class="evidence-list"><div><dt>Decision</dt><dd>@sim.Proposed!.Decision</dd></div><div><dt>Execution Guidance</dt><dd>@sim.Proposed.ExecutionGuidance</dd></div><div><dt>ShouldProceed</dt><dd>@(sim.Proposed.ShouldProceed ? "Yes":"No")</dd></div><div><dt>Winning policy</dt><dd>@sim.Proposed.WinningPolicy</dd></div><div><dt>Reason</dt><dd>@sim.Proposed.Reason</dd></div><div><dt>Approval state</dt><dd>@(sim.Proposed.ApprovalStatus??"Not applicable")</dd></div><div><dt>Hypothetical fingerprint</dt><dd><code>@sim.ProposedGovernanceConfigurationFingerprint</code></dd></div></dl></section></div><h3>DIFFERENCE</h3>@if(sim.Differences.Count==0){<p>The proposed static governance context differs, but the simulated runtime outcome for this request did not change.</p>}else{<dl class="evidence-list">@foreach(var difference in sim.Differences){<div><dt>@difference.Field</dt><dd>@difference.Current → @difference.Proposed</dd></div>}</dl>}</section>
var impact=sim.StaticGovernanceContextComparison!;<section class="panel"><h2>6. Static governance context comparison</h2><dl class="evidence-list"><div><dt>Configured capabilities</dt><dd>@impact.CurrentConfiguredCapabilities → @impact.ProposedConfiguredCapabilities</dd></div><div><dt>Critical capabilities</dt><dd>@impact.CurrentCriticalCapabilities → @impact.ProposedCriticalCapabilities</dd></div><div><dt>High capabilities</dt><dd>@impact.CurrentHighCapabilities → @impact.ProposedHighCapabilities</dd></div><div><dt>Affected identity</dt><dd>@impact.Identity</dd></div><div><dt>Affected policy</dt><dd>@impact.Policy</dd></div><div><dt>Affected environment</dt><dd>@string.Join(", ",impact.Environments)</dd></div></dl><p>@impact.Limitation</p></section>}}
<section class="panel"><h2>7. Limitations</h2><ul>@foreach(var limitation in review.Limitations){<li>@limitation</li>}</ul></section>
<nav class="investigation-actions"><a href="/identity-activity?identityId=@Uri.EscapeDataString(review.IdentityId)">Back to identity</a><a href="/capability-explorer?capabilityId=@Uri.EscapeDataString(review.CapabilityId)">View capability</a><a href="/capability-activity?capabilityId=@Uri.EscapeDataString(review.CapabilityId)&identity=@Uri.EscapeDataString(review.IdentityId)">View evidence</a>@foreach(var policy in item?.Policies??[]){<a href="/policies?policyId=@Uri.EscapeDataString(policy)">View policy</a>}</nav>
<footer class="app-footer">Seneschal v0.2.1-alpha</footer></main></div></body></html>
