@page "/resources"
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Seneschal Resources</title>
    <link rel="stylesheet" href="/styles.css" />
</head>
<body>
    <div class="app-shell">
        @await Html.PartialAsync("Shared/_PortalSidebar", "resources")

        <main class="container explorer-page">
            <header class="page-header">
                <div class="breadcrumb">Governance / Resources</div>
                <h1>Resources</h1>
                <p class="subtitle">
                    Resource governance context projected from configured
                    policies and runtime activity.
                </p>
            </header>

            <section class="panel">
                <h2>Resource Explorer Coming Soon — Planned</h2>
                <div class="empty-state">
                    <p class="muted">
                        Resources are currently represented through policy
                        environment and resource context.
                    </p>
                    <p class="muted">
                        Use the Relationship Graph or Audit Trail to inspect
                        resource relationships already observed by Seneschal.
                    </p>
                </div>
            </section>

            <footer class="app-footer">Seneschal v0.2.1-alpha</footer>
        </main>
    </div>
</body>
</html>
