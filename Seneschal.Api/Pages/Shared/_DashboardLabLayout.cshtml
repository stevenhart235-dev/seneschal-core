@{
    var active = ViewData["LabActive"]?.ToString() ?? "";
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · Seneschal Design Lab</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@tabler/core@@1.4.0/dist/css/tabler.min.css" crossorigin="anonymous" />
    <link rel="stylesheet" href="/design-lab/dashboard-lab.css" />
</head>
<body class="dashboard-lab">
<div class="page">
    <aside class="navbar navbar-vertical navbar-expand-lg" data-bs-theme="dark" aria-label="Design Lab navigation">
        <div class="container-fluid">
            <h1 class="navbar-brand navbar-brand-autodark"><a href="/dashboard1">Seneschal <span>Design Lab</span></a></h1>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#lab-nav" aria-controls="lab-nav" aria-expanded="false" aria-label="Toggle prototype navigation"><span class="navbar-toggler-icon"></span></button>
            <div class="collapse navbar-collapse" id="lab-nav">
                <ul class="navbar-nav pt-lg-3">
                    <li class="nav-item"><a class="nav-link @(active == "operations" ? "active" : "")" href="/dashboard1"><span class="nav-link-title">Operations</span></a></li>
                    <li class="nav-item"><a class="nav-link @(active == "investigation" ? "active" : "")" href="/dashboard2"><span class="nav-link-title">Investigation</span></a></li>
                    <li class="nav-item"><a class="nav-link @(active == "capability" ? "active" : "")" href="/dashboard3"><span class="nav-link-title">Capability</span></a></li>
                </ul>
                <div class="lab-sidebar-note mt-auto"><span class="badge bg-azure-lt">Static snapshot</span><p>Experimental UI. Production Dashboard is unchanged.</p><a href="/dashboard">Return to Dashboard</a></div>
            </div>
        </div>
    </aside>
    <div class="page-wrapper">@RenderBody()</div>
</div>
<script src="https://cdn.jsdelivr.net/npm/@@tabler/core@@1.4.0/dist/js/tabler.min.js" defer></script>
</body>
</html>
