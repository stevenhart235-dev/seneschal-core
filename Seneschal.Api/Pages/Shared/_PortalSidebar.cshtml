            <a class="@Active("incidents")" aria-current="@Current("incidents")" href="/incidents"><span>Incidents</span></a>
        </div>
        <div class="nav-section">
            <div class="nav-section-title">System<span class="visually-hidden"> (Explore)</span></div>
            <a class="@Active("graph")" aria-current="@Current("graph")" href="/graph-view"><span>Relationship Graph</span></a>
            <a class="@Active("diagnostics")" aria-current="@Current("diagnostics")" href="/diagnostics"><span>Diagnostics</span></a>
        </div>
    </nav>
