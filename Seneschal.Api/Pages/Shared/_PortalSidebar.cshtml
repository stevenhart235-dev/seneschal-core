        <span>Seneschal</span>
        <small>Capability control plane</small>
    </div>
    <nav class="sidebar-nav" aria-label="Primary navigation">
        <div class="nav-section">
            <div class="nav-section-title">Overview</div>
            <a class="@Active("dashboard")" href="/dashboard" aria-current="@Current("dashboard")"><span>Dashboard</span></a>
            <a class="@Active("monitor")" aria-current="@Current("monitor")" href="/monitor"><span>Monitor</span></a>
        </div>
        <div class="nav-section">
            <div class="nav-section-title">Governance</div>
            <a class="@Active("governance")" aria-current="@Current("governance")" href="/governance"><span>Runtime Governance</span></a>
            <a class="@Active("policies")" aria-current="@Current("policies")" href="/policies"><span>Policies</span></a>
            <a class="@Active("capabilities")" aria-current="@Current("capabilities")" href="/capability-explorer"><span>Capabilities</span></a>
            <a class="@Active("identities")" aria-current="@Current("identities")" href="/identities"><span>Identities</span></a>
            <a class="@Active("resources")" aria-current="@Current("resources")" href="/resources"><span>Resources</span></a>
