@page "/technologies"
@model Seneschal.Api.Pages.TechnologiesModel
@{ Layout = null; }
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>Seneschal Technology Explorer</title><link rel="stylesheet" href="/styles.css"/><link rel="stylesheet" href="/technology-explorer.css"/><link rel="stylesheet" href="/technology-surface-refinement.css"/></head>
<body class="technology-surface"><div class="app-shell">@await Html.PartialAsync("Shared/_PortalSidebar", "")
<main class="container technology-page"><header class="page-header"><div><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/dashboard">Dashboard</a> / Technologies</nav><h1>Technology Explorer</h1><p class="subtitle">Investigate capability activity across your technology stack.</p></div><a class="button-link" href="/audit">Open Audit Trail</a></header>
@if(Model.Technologies.Count == 0){<section class="panel empty-state"><strong>No technologies discovered</strong><p>No capability catalog entries or runtime evidence are available to classify.</p><a href="/capability-explorer">Review Capability Explorer</a></section>}else{
<section class="technology-grid" aria-label="Governed technologies">@foreach(var technology in Model.Technologies){var requiresAttention=technology.DenyCount+technology.PendingApprovalCount>0;var state=technology.EvaluationCount==0?"configured":requiresAttention?"attention":"healthy";if(technology.Key=="custom")state="custom";if(technology.Key=="unclassified")state="unclassified";<a class="technology-card technology-state-@state @(requiresAttention?"technology-attention":"")" href="/technologies/@Uri.EscapeDataString(technology.Key)" aria-label="Open @technology.DisplayName technology details"><header><span class="technology-icon"><img src="@technology.IconPath" alt="" /></span><span class="technology-name"><small>@(technology.EvaluationCount==0?"Configured · not observed":requiresAttention?"Active · attention required":"Active · no attention required")</small><strong>@technology.DisplayName</strong></span></header><p>@(technology.EvaluationCount==0?"Capability metadata is configured; no runtime evidence has been observed.":technology.Description)</p><dl class="technology-card-metrics"><div><dt>Applications</dt><dd>@technology.ApplicationCount</dd></div><div><dt>Capabilities</dt><dd>@technology.CapabilityCount</dd></div><div><dt>Evaluations</dt><dd>@technology.EvaluationCount</dd></div></dl><footer><span class="technology-outcomes">@if(technology.DenyCount>0){<b class="decision-badge decision-deny">@technology.DenyCount denied</b>}@if(technology.PendingApprovalCount>0){<b class="decision-badge decision-pendingapproval">@technology.PendingApprovalCount Pending Approval</b>}@if(technology.EvaluationCount>0&&!requiresAttention){<em>No denied or Pending Approval decisions</em>}@if(technology.EvaluationCount==0){<em>No runtime evidence</em>}</span><span><small>Last observed</small><strong>@(technology.LastObservedAt?.ToString("u") ?? "Not observed")</strong></span></footer></a>}</section>}
<footer class="app-footer">Seneschal v0.2.1-alpha</footer></main></div></body></html>
