@page "/technologies/{technologyKey}"
@model Seneschal.Api.Pages.TechnologyDetailModel
@using Seneschal.Core.Enums
@{ Layout = null; var technology = Model.Technology; }
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>Seneschal @technology.DisplayName Technology</title><link rel="stylesheet" href="/styles.css"/><link rel="stylesheet" href="/technology-explorer.css"/></head>
<body><div class="app-shell">@await Html.PartialAsync("Shared/_PortalSidebar", "")
<main class="container technology-page"><header class="page-header technology-detail-header"><div><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/dashboard">Dashboard</a> / <a href="/technologies">Technologies</a> / @technology.DisplayName</nav><div class="technology-title"><span class="technology-icon technology-icon-large"><img src="@technology.IconPath" alt="" /></span><div><span class="technology-activity-state">@(technology.EvaluationCount==0?"Configured · not observed":technology.DenyCount+technology.PendingApprovalCount>0?"Active · attention required":"Active · no attention required")</span><h1>@technology.DisplayName</h1><p class="subtitle">@technology.Description</p></div></div></div><a class="button-link" href="/audit">Open Audit Trail</a></header>
<section class="technology-summary" aria-label="Technology runtime summary"><article><span>Evaluations</span><strong>@technology.EvaluationCount</strong></article><article><span>Allowed</span><strong class="metric-allow">@technology.AllowCount</strong></article><article><span>Denied</span><strong class="metric-deny">@technology.DenyCount</strong></article><article><span>Pending Approval</span><strong class="metric-pending">@technology.PendingApprovalCount</strong></article><article><span>Last observed</span><strong>@(technology.LastObservedAt?.ToString("u") ?? "Not observed")</strong></article><article><span>Runtime modes</span><strong>@(technology.RuntimeModesObserved.Count == 0 ? "Not observed" : string.Join(", ", technology.RuntimeModesObserved))</strong></article></section>
@if(technology.EvaluationCount==0){<section class="technology-catalog-status" aria-label="Catalog-only technology status"><strong>Configured · not observed</strong><span>@technology.CapabilityCount configured @(technology.CapabilityCount==1?"capability":"capabilities")</span><span>0 applications observed</span><span>0 runtime evaluations</span></section>}else{@await Html.PartialAsync("Shared/_TechnologyRecentDecisions", technology)<section class="panel technology-section technology-applications"><header class="technology-section-header"><div><h2>Applications</h2><p>Workload identities observed using @technology.DisplayName capabilities.</p></div><span>@technology.ApplicationCount @(technology.ApplicationCount==1?"application":"applications")</span></header><div class="activity-table-wrap"><table class="activity-table"><thead><tr><th>Application</th><th>Executions</th><th>Denied</th><th>Pending Approval</th><th>Capabilities used</th><th>Last observed</th><th>Investigation</th></tr></thead><tbody>@foreach(var app in technology.Applications){<tr><td><a href="/identity-activity?identityId=@Uri.EscapeDataString(app.Name)">@app.Name</a></td><td>@app.EvaluationCount</td><td class="outcome-deny">@app.DenyCount</td><td class="outcome-pending">@app.PendingApprovalCount</td><td>@app.CapabilityCount</td><td>@app.LastObservedAt.ToString("u")</td><td><a href="/identity-activity?identityId=@Uri.EscapeDataString(app.Name)">View Application Activity</a></td></tr>}</tbody></table></div></section>}
<section class="panel technology-section"><header class="technology-section-header"><div><h2>Capabilities</h2><p>Configured and observed governance objects classified under @technology.DisplayName.</p></div><span>@technology.CapabilityCount @(technology.CapabilityCount==1?"capability":"capabilities")</span></header><div class="activity-table-wrap"><table class="activity-table"><thead><tr><th>Capability</th><th>Owner</th><th>Risk</th><th>Executions</th><th>Denied</th><th>Pending Approval</th><th>Last observed</th><th>Investigation</th></tr></thead><tbody>@foreach(var capability in technology.Capabilities){<tr><td><a href="/capability-explorer?capabilityId=@Uri.EscapeDataString(capability.Id)">@capability.DisplayName</a><code>@capability.Id</code></td><td>@(capability.Owner ?? "Not recorded")</td><td>@(capability.Risk ?? "Not classified")</td><td>@capability.EvaluationCount</td><td class="outcome-deny">@capability.DenyCount</td><td class="outcome-pending">@capability.PendingApprovalCount</td><td>@(capability.LastObservedAt?.ToString("u") ?? "Not observed")</td><td><a href="/capability-activity?capabilityId=@Uri.EscapeDataString(capability.Id)">Capability Activity</a></td></tr>}</tbody></table></div></section>
@if(technology.EvaluationCount==0){<section class="panel technology-section"><header class="technology-section-header"><div><h2>Recent decisions</h2><p>Latest retained Decision Trace evidence for this technology.</p></div><a href="/audit">View Audit Trail</a></header>
@if(technology.RecentDecisions.Count==0){<div class="empty-state"><strong>No decisions recorded</strong><p>Configured capabilities have no retained audit evidence.</p></div>}else{<div class="activity-table-wrap"><table class="activity-table"><thead><tr><th>Time</th><th>Application</th><th>Capability</th><th>Environment</th><th>Decision</th><th>Reason</th><th>Investigation</th></tr></thead><tbody>@foreach(var decision in technology.RecentDecisions.Take(12)){var label=decision.Decision==DecisionType.RequireApproval?"Pending Approval":decision.Decision.ToString();<tr><td>@decision.TimestampUtc.ToString("u")</td><td><a href="/identity-activity?identityId=@Uri.EscapeDataString(decision.IdentityId)">@decision.IdentityId</a></td><td><a href="/capability-activity?capabilityId=@Uri.EscapeDataString(decision.CapabilityId)">@decision.CapabilityId</a></td><td>@(string.IsNullOrWhiteSpace(decision.Environment)?"Not provided":decision.Environment)</td><td><span class="decision-badge decision-@label.Replace(" ","").ToLowerInvariant()">@label</span></td><td class="technology-reason">@decision.Reason</td><td><a href="/audit/@Uri.EscapeDataString(decision.Id)">View Decision Trace</a></td></tr>}</tbody></table></div>}</section>}
<section class="panel technology-governance"><header class="technology-section-header"><div><h2>Governance context</h2><p>Concise policy, runtime-mode, window, and approval evidence.</p></div></header><div class="technology-governance-grid"><div><h3>Matched policies</h3>@if(technology.MatchedPolicies.Count==0){<p>No matched policy evidence recorded.</p>}else{<ul>@foreach(var policy in technology.MatchedPolicies){<li><a href="/audit?matchedPolicy=@Uri.EscapeDataString(policy)">@policy</a></li>}</ul>}<a href="/policies">Open Policy Explorer</a></div><div><h3>Runtime modes</h3><p>@(technology.RuntimeModesObserved.Count==0?"No runtime mode evidence recorded.":string.Join(", ",technology.RuntimeModesObserved))</p><a href="/governance">Runtime Governance</a></div><div><h3>Governance Window</h3><p>@(technology.GovernanceWindowApplies?$"{technology.GovernanceWindow.Name} · {technology.GovernanceWindow.Mode}":"No active window applies to these capabilities.")</p><a href="/governance-windows">Governance Windows</a></div><div><h3>Approval evidence</h3><p>@(technology.PendingApprovalCount>0?$"{technology.PendingApprovalCount} evaluations required approval.":"No Pending Approval evaluations recorded.")</p><a href="/approvals">Approvals</a></div></div></section>
<footer class="app-footer">Seneschal v0.2.1-alpha</footer></main></div></body></html>
