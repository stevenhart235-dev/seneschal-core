<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.15" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
    <PackageReference Include="JsonSchema.Net" Version="9.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Seneschal.Core\Seneschal.Core.csproj" />
    <ProjectReference Include="..\Seneschal.Persistence.PostgreSql\Seneschal.Persistence.PostgreSql.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Policies\*.yaml"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\integrations\contracts\policy\policy-schema.v1.json"
          Link="contracts\policy\policy-schema.v1.json"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\integrations\contracts\proposed-governance-change\proposed-governance-change.v1.schema.json"
          Link="contracts\proposed-governance-change\proposed-governance-change.v1.schema.json"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
