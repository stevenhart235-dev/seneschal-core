<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <PackageId>Seneschal.AspNetCore</PackageId>
    <Version>0.1.0-alpha.1</Version>
    <Authors>Steven Hart</Authors>
    <Company>Seneschal</Company>
    <Copyright>Copyright (c) 2026 Steven Hart</Copyright>
    <Description>ASP.NET Core middleware and endpoint metadata for Seneschal capability governance.</Description>
    <PackageTags>seneschal;aspnetcore;capability-governance;authorization;middleware</PackageTags>
    <PackageProjectUrl>https://github.com/stevenhart235-dev/seneschal-core</PackageProjectUrl>
    <RepositoryUrl>https://github.com/stevenhart235-dev/seneschal-core</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReleaseNotes>Pre-release package. See the repository release history for changes.</PackageReleaseNotes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\artifacts\packages</PackageOutputPath>
    <DebugType Condition="'$(Configuration)' == 'Release'">embedded</DebugType>
    <PathMap Condition="'$(Configuration)' == 'Release'">$(MSBuildProjectDirectory)=/_/Seneschal.AspNetCore</PathMap>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Seneschal.Client\Seneschal.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
