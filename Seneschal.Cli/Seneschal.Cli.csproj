<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Seneschal.Api\Seneschal.Api.csproj" />
    <ProjectReference Include="..\Seneschal.Client\Seneschal.Client.csproj" />
    <ProjectReference Include="..\Seneschal.Core\Seneschal.Core.csproj" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="9.0.1" />
    <PackageReference Include="JsonSchema.Net" Version="9.4.0" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>seneschal</ToolCommandName>
    <IsPackable>true</IsPackable>
    <PackageId>Seneschal.Cli</PackageId>
    <Version>0.1.0-alpha.1</Version>
    <Authors>Steven Hart</Authors>
    <Company>Seneschal</Company>
    <Copyright>Copyright (c) 2026 Steven Hart</Copyright>
    <Description>Command-line tools for validating and exploring Seneschal capability governance integrations.</Description>
    <PackageTags>seneschal;cli;dotnet-tool;capability-governance;preflight</PackageTags>
    <PackageProjectUrl>https://github.com/stevenhart235-dev/seneschal-core</PackageProjectUrl>
    <RepositoryUrl>https://github.com/stevenhart235-dev/seneschal-core</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReleaseNotes>Pre-release package. See the repository release history for changes.</PackageReleaseNotes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\artifacts\packages</PackageOutputPath>
    <DebugType Condition="'$(Configuration)' == 'Release'">embedded</DebugType>
    <PathMap Condition="'$(Configuration)' == 'Release'">$(MSBuildProjectDirectory)=/_/Seneschal.Cli</PathMap>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\integrations\contracts\capability-pack\capability-pack.v1.schema.json"
          Link="contracts\capability-pack\capability-pack.v1.schema.json"
          CopyToOutputDirectory="PreserveNewest"
          Pack="true"
          PackagePath="contracts\capability-pack\" />    <None Include="..\integrations\contracts\policy\policy-schema.v1.json"
          Link="contracts\policy\policy-schema.v1.json"
          CopyToOutputDirectory="PreserveNewest"
          Pack="true"
          PackagePath="contracts\policy\" />
  </ItemGroup>

</Project>
