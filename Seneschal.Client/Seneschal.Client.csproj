<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <PackageId>Seneschal.Client</PackageId>
    <Version>0.1.0-alpha.1</Version>
    <Authors>Steven Hart</Authors>
    <Company>Seneschal</Company>
    <Copyright>Copyright (c) 2026 Steven Hart</Copyright>
    <Description>.NET client for requesting capability governance decisions from the Seneschal runtime.</Description>
    <PackageTags>seneschal;capability-governance;authorization;policy</PackageTags>
    <PackageProjectUrl>https://github.com/stevenhart235-dev/seneschal-core</PackageProjectUrl>
    <RepositoryUrl>https://github.com/stevenhart235-dev/seneschal-core</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReleaseNotes>Pre-release package. See the repository release history for changes.</PackageReleaseNotes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\artifacts\packages</PackageOutputPath>
    <DebugType Condition="'$(Configuration)' == 'Release'">embedded</DebugType>
    <PathMap Condition="'$(Configuration)' == 'Release'">$(MSBuildProjectDirectory)=/_/Seneschal.Client</PathMap>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Options" Version="8.0.2" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
